@model PaymentConfirmationViewModel
@{
    ViewData["Title"] = "Confirm Payment";
    Layout = "_DashboardLayout";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="heading display-6">Confirm Payment</h2>
        <p class="m-0 text-muted lead">Please review your payment details before confirming</p>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <div class="mb-4">
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">Service</span>
                            <span class="fw-semibold">@Model.TariffName</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">Amount</span>
                            <span class="fw-semibold">R @Model.Amount.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">Reference</span>
                            <span class="fw-semibold">@Model.Reference</span>
                        </div>
                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted">Date</span>
                            <span class="fw-semibold">@Model.PaymentDate.ToString("dd MMM yyyy, HH:mm")</span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <form asp-action="Confirm" method="post" class="flex-grow-1">
                            <input type="hidden" name="id" value="@Model.PaymentId" />
                            <input type="hidden" name="confirm" value="true" />
                            <button type="submit" class="btn btn-dark w-100">
                                <i class="fas fa-check-circle me-2"></i>Confirm Payment
                            </button>
                        </form>
                        <form asp-action="Confirm" method="post">
                            <input type="hidden" name="id" value="@Model.PaymentId" />
                            <input type="hidden" name="confirm" value="false" />
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="fas fa-times"></i>
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>