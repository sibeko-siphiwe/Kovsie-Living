@model PaymentConfirmationViewModel
@{
    ViewData["Title"] = "Confirm Payment";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading mb-1">Confirm Payment</h2>
            <p class="text-muted mb-0">Please review your payment details before confirming.</p>
        </div>
        <a asp-action="MakePayment" asp-controller="Payment" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card stat-card">
                <div class="card-body">

                    <h6 class="heading mb-3">Payment Details</h6>

                    <div class="border-top pt-3">

                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted small text-uppercase">Service</span>
                            <span class="fw-semibold">@Model.TariffName</span>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-top">
                            <span class="text-muted small text-uppercase">Amount</span>
                            <span class="fw-semibold">R @Model.Amount.ToString("N2")</span>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-top">
                            <span class="text-muted small text-uppercase">Reference</span>
                            <span class="fw-semibold">@Model.Reference</span>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-top">
                            <span class="text-muted small text-uppercase">Date</span>
                            <span class="fw-semibold">@Model.PaymentDate.ToString("dd MMM yyyy, HH:mm")</span>
                        </div>

                    </div>

                    <div class="d-flex gap-2 mt-4 pt-3 border-top">

                        <form asp-action="Confirm" method="post" class="flex-grow-1 m-0">
                            <input type="hidden" name="id" value="@Model.PaymentId" />
                            <input type="hidden" name="confirm" value="true" />
                            <button type="submit" class="btn btn-sm btn-dark-soft w-100">
                                <i class="fas fa-check me-1"></i>Confirm Payment
                            </button>
                        </form>

                        <form asp-action="Confirm" method="post" class="m-0" onsubmit="return confirm('Cancel this payment?')">
                            <input type="hidden" name="id" value="@Model.PaymentId" />
                            <input type="hidden" name="confirm" value="false" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-times"></i>
                            </button>
                        </form>

                    </div>

                </div>
            </div>

        </div>
    </div>

</div>