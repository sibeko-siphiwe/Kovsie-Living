@model IEnumerable<Payment>
@{
    ViewData["Title"] = "Pending Payments";
    Layout = "_DashboardLayout";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading display-6 m-0">Pending Payments</h2>
            <p class="m-0 lead text-muted">Review and approve customer payments</p>
        </div>
    </div>

    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-3" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card px-4 py-2">
        <div class="card-header text-center border-bottom bg-white">
            <h6 class="m-0 pb-2">Pending Payments</h6>
        </div>
        <div class="card-body px-0 pb-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive-lg">
                    <table class="table table-bordered align-middle text-center">
                        <thead class="table-light">
                            <tr>
                                <th>Customer</th>
                                <th>Service</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Reference</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model)
                            {
                                <tr>
                                    <td>@payment.User?.FullName</td>
                                    <td>@payment.Tariff?.Name</td>
                                    <td>R @payment.Amount.ToString("N2")</td>
                                    <td>@payment.PaymentDate.ToString("dd MMM yyyy, HH:mm")</td>
                                    <td><code>@payment.Reference</code></td>
                                    <td>
                                        <div class="d-flex gap-1 justify-content-center">
                                            <form asp-action="ApprovePayment" asp-controller="Dashboard" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@payment.PaymentId" />
                                                <button type="submit" class="btn btn-sm btn-success" title="Approve">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                            <form asp-action="RejectPayment" asp-controller="Dashboard" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@payment.PaymentId" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="Reject" onclick="return confirm('Reject this payment?')">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center">
                    <i class="fas fa-check-circle fa-3x text-muted m-3"></i>
                    <h5 class="text-muted">No Pending Payments</h5>
                    <p class="mb-3 text-muted">All payments have been processed.</p>
                </div>
            }

        </div>
    </div>

</div>