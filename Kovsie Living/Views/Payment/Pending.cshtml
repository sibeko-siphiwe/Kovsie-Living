@model IEnumerable<Payment>
@{
    ViewData["Title"] = "Pending Payments";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading mb-1">Pending Payments</h2>
            <p class="text-muted mb-0">Review and approve customer payments.</p>
        </div>
    </div>

    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-4" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card stat-card">
        <div class="card-body pb-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="heading mb-1">Pending Payments</h6>
                    <p class="text-muted small mb-0">@Model.Count() payment@(Model.Count() == 1 ? "" : "s") awaiting review</p>
                </div>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <table class="table table-clean mb-0 w-100">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Service</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Reference</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@payment.User?.FullName</td>
                            <td>@payment.Tariff?.Name</td>
                            <td class="fw-semibold">R @payment.Amount.ToString("N2")</td>
                            <td class="text-muted">@payment.PaymentDate.ToString("dd MMM yyyy, HH:mm")</td>
                            <td><code>@payment.Reference</code></td>
                            <td class="text-nowrap text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <form asp-action="ApprovePayment" asp-controller="Dashboard" method="post" class="m-0">
                                        <input type="hidden" name="id" value="@payment.PaymentId" />
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Approve">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                    <form asp-action="RejectPayment" asp-controller="Dashboard" method="post" class="m-0" onsubmit="return confirm('Reject this payment?')">
                                        <input type="hidden" name="id" value="@payment.PaymentId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Reject">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-check-circle fa-2x text-muted mb-3"></i>
                <h6 class="heading mb-1">No Pending Payments</h6>
                <p class="text-muted small mb-0">All payments have been processed.</p>
            </div>
        }
    </div>

</div>