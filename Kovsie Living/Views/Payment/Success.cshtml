@model PaymentConfirmationViewModel
@{
    ViewData["Title"] = "Payment Successful";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card stat-card text-center">
                <div class="card-body py-5">

                    <i class="fas fa-check-circle text-success mb-3" style="font-size: 3rem;"></i>

                    <h3 class="heading mb-1">Payment Successful</h3>
                    <p class="text-muted small mb-4">Your payment has been processed successfully.</p>

                    <div class="text-start border-top pt-3">

                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted small text-uppercase">Service</span>
                            <span class="fw-semibold">@Model.TariffName</span>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-top">
                            <span class="text-muted small text-uppercase">Amount</span>
                            <span class="fw-semibold">R @Model.Amount.ToString("N2")</span>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-top">
                            <span class="text-muted small text-uppercase">Reference</span>
                            <span class="fw-semibold">@Model.Reference</span>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-top">
                            <span class="text-muted small text-uppercase">Date</span>
                            <span class="fw-semibold">@Model.PaymentDate.ToString("dd MMM yyyy, HH:mm")</span>
                        </div>

                    </div>

                    <div class="d-flex gap-2 justify-content-center mt-4 pt-3 border-top">
                        <a asp-action="History" asp-controller="Payment" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-clock-rotate-left me-1"></i>View History
                        </a>
                        <a asp-action="Index" asp-controller="Customer" class="btn btn-sm btn-dark-soft">
                            <i class="fas fa-home me-1"></i>Dashboard
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>

</div>