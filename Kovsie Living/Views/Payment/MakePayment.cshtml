@model MakePaymentViewModel
@{
    ViewData["Title"] = "Make Payment";
    Layout = "_DashboardLayout";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="heading display-6">Make Payment</h2>
        <p class="m-0 text-muted lead">Pay for your estate services</p>
    </div>

    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-3" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <form asp-action="MakePayment" method="post">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="TariffId" class="form-label fw-semibold"></label>
                            <select asp-for="TariffId" class="form-select">
                                @foreach (var tariff in Model.AvailableTariffs)
                                {
                                    <option value="@tariff.TariffId">@tariff.Name - R @tariff.Amount.ToString("N2")</option>
                                }
                            </select>
                            <span asp-validation-for="TariffId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input asp-for="Amount" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-dark w-100">
                            <i class="fas fa-credit-card me-2"></i>Pay Now
                        </button>

                    </form>

                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h6 class="m-0 fw-semibold">Available Services</h6>
                </div>
                <div class="card-body">
                    @if (Model.AvailableTariffs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Service</th>
                                        <th>Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tariff in Model.AvailableTariffs)
                                    {
                                        <tr>
                                            <td>@tariff.Name</td>
                                            <td>R @tariff.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <p class="text-muted">No services available</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>