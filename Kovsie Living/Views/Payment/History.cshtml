@model PaymentHistoryViewModel
@{
    ViewData["Title"] = "Payment History";
    Layout = "_DashboardLayout";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="heading display-6">Payment History</h2>
        <p class="m-0 text-muted lead">View all your payments</p>
    </div>

    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-3" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row gap-2 g-2 mb-4">
        <div class="col-md-4">
            <div class="p-3 border rounded">
                <h6 class="text-muted mb-1">Total Paid</h6>
                <h3 class="mb-0 text-success">R @Model.TotalPaid.ToString("N2")</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 border rounded">
                <h6 class="text-muted mb-1">Pending Payments</h6>
                <h3 class="mb-0 text-warning">R @Model.TotalPending.ToString("N2")</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 border rounded">
                <h6 class="text-muted mb-1">Total Transactions</h6>
                <h3 class="mb-0 text-primary">@Model.PaymentCount</h3>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">

            @if (Model.Payments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Service</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Reference</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.Payments)
                            {
                                string statusBadge;
                                string statusColor;
                                if (payment.Status == "Paid")
                                {
                                    statusBadge = "Paid";
                                    statusColor = "bg-success";
                                }
                                else if (payment.Status == "Pending")
                                {
                                    statusBadge = "Pending";
                                    statusColor = "bg-warning text-dark";
                                }
                                else if (payment.Status == "Cancelled")
                                {
                                    statusBadge = "Cancelled";
                                    statusColor = "bg-danger";
                                }
                                else
                                {
                                    statusBadge = payment.Status;
                                    statusColor = "bg-secondary";
                                }

                                <tr>
                                    <td>@payment.Tariff?.Name</td>
                                    <td>R @payment.Amount.ToString("N2")</td>
                                    <td>@payment.PaymentDate.ToString("dd MMM yyyy, HH:mm")</td>
                                    <td><span class="badge @statusColor">@statusBadge</span></td>
                                    <td><code>@payment.Reference</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center">
                    <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No Payments Yet</h5>
                    <p class="text-muted">You haven't made any payments yet.</p>
                    <a asp-action="MakePayment" asp-controller="Payment" class="btn btn-dark">
                        <i class="fas fa-credit-card me-2"></i>Make Payment
                    </a>
                </div>
            }

        </div>
    </div>

</div>