@model CreateOfficerViewModel
@{
    ViewData["Title"] = "Create Financial Officer";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading mb-1">Create Financial Officer</h2>
            <p class="text-muted mb-0">Register a new officer to the system to get started.</p>
        </div>
        <a asp-action="Officers" asp-controller="Dashboard" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="card stat-card">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label small text-muted text-uppercase"></label>
                        <input asp-for="FirstName" class="form-control form-control-sm" placeholder="e.g John" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label small text-muted text-uppercase"></label>
                        <input asp-for="LastName" class="form-control form-control-sm" placeholder="e.g Doe" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="EmployeeNumber" class="form-label small text-muted text-uppercase"></label>
                        <input asp-for="EmployeeNumber" class="form-control form-control-sm" placeholder="e.g 50123456" />
                        <span asp-validation-for="EmployeeNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="PhoneNumber" class="form-label small text-muted text-uppercase"></label>
                        <input asp-for="PhoneNumber" class="form-control form-control-sm" placeholder="e.g 0712345678" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="TemporaryPassword" class="form-label small text-muted text-uppercase"></label>
                        <input type="text" asp-for="TemporaryPassword" class="form-control form-control-sm" />
                        <span asp-validation-for="TemporaryPassword" class="text-danger small"></span>
                    </div>

                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-sm btn-dark-soft">
                        <i class="fas fa-check me-1"></i>Create Officer
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>