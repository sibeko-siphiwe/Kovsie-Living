@model RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="container">
    <div class="py-5 d-flex justify-content-center align-items-center">
        <form asp-action="Register" method="post" class="frmRegister mt-5">
            <div class="text-center mb-5">
                <h2 class="display-6 m-0 heading">Create an account</h2>
                <p class="m-0 lead text-muted">We're excited to have you join us on our platform</p>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <div class="btn-group w-100" role="group" id="userTypeToggle">
                    <input type="radio" class="btn-check" asp-for="IsStudent" value="true" id="studentRadio" autocomplete="off">
                    <label class="btn btn-outline-dark" for="studentRadio">Student</label>

                    <input type="radio" class="btn-check" asp-for="IsStudent" value="false" id="staffRadio" autocomplete="off">
                    <label class="btn btn-outline-dark" for="staffRadio">Staff</label>
                </div>
                <span asp-validation-for="IsStudent" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <div class="row">
                    <div class="col-md">
                        <label asp-for="FirstName" class="mb-1"></label>
                        <input asp-for="FirstName" class="form-control" placeholder="Enter your first name" />
                    </div>
                    <div class="col-md">
                        <label asp-for="LastName" class="mb-1"></label>
                        <input asp-for="LastName" class="form-control" placeholder="Enter your last name" />
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="UserName" class="form-label" id="userNameLabel"></label>
                <input asp-for="UserName" class="form-control" placeholder="e.g 2010936382" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <div class="row">
                    <div class="col-md">
                        <div>
                            <label asp-for="UnitNumber" class="form-label"></label>
                            <input asp-for="UnitNumber" class="form-control" placeholder="e.g A450" />
                            <span asp-validation-for="UnitNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md">
                        <div>
                            <label asp-for="VehicleNumber" class="form-label"></label>
                            <input asp-for="VehicleNumber" class="form-control" placeholder="e.g 3" />
                            <span asp-validation-for="VehicleNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="Enter your new password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm your password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-dark w-100 mb-3">Create Account</button>
            <p class="text-center">Already have an account? <a asp-action="Login" asp-controller="Account">Login</a></p>
        </form>
    </div>
</div>