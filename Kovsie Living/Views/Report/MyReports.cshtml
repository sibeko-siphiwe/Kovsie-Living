@model IEnumerable<ReportViewModel>
@{
    ViewData["Title"] = "My Reports";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading mb-1">My Reports</h2>
            <p class="text-muted mb-0">View all reports you have generated.</p>
        </div>
        <a asp-action="Generate" class="btn btn-sm btn-dark-soft">
            <i class="fas fa-plus me-1"></i>Generate Report
        </a>
    </div>

    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-4" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card stat-card">
        <div class="card-body pb-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="heading mb-1">Generated Reports</h6>
                    <p class="text-muted small mb-0">@Model.Count() report@(Model.Count() == 1 ? "" : "s") found</p>
                </div>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <table class="table table-clean mb-0 w-100">
                <thead>
                    <tr> 
                        <th>Type</th>
                        <th>Date Range</th>
                        <th>Generated Date</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model)
                    {
                        string typeBadge = report.ReportType switch
                        {
                            "Payments" => "badge-soft-green",
                            "Customers" => "badge-soft-blue",
                            "Revenue" => "badge-soft-yellow",
                            _ => "badge-soft-gray"
                        };

                        <tr> 
                            <td>
                                <span class="@typeBadge">@report.ReportType</span>
                            </td>
                            <td class="text-muted">@report.StartDate.ToString("dd MMM yyyy") - @report.EndDate.ToString("dd MMM yyyy")</td>
                            <td class="text-muted">@report.GeneratedDate.ToString("dd MMM yyyy, HH:mm")</td>
                            <td>
                                @if (report.Status == "Generated")
                                {
                                    <span class="badge-soft-green">Generated</span>
                                }
                                else
                                {
                                    <span class="badge-soft-gray">@report.Status</span>
                                }
                            </td>
                            <td class="text-nowrap text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-sm dropdown-menu-end">
                                        <a asp-action="Details" asp-route-id="@report.ReportId" class="dropdown-item">
                                            <i class="fas fa-eye me-2"></i>View Details
                                        </a>
                                        @if (!string.IsNullOrEmpty(report.FilePath))
                                        {
                                            <a asp-action="DownloadPdf" asp-route-id="@report.ReportId" class="dropdown-item">
                                                <i class="fas fa-download me-2"></i>Download PDF
                                            </a>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-file-alt fa-2x text-muted mb-3"></i>
                <h6 class="heading mb-1">No Reports Generated Yet</h6>
                <p class="text-muted small mb-3">Generate your first report to see it here.</p>
                <a asp-action="Generate" class="btn btn-sm btn-dark-soft">
                    <i class="fas fa-plus me-1"></i>Generate First Report
                </a>
            </div>
        }
    </div>

</div>