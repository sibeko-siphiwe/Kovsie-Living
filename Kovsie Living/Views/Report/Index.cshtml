@model IEnumerable<ReportViewModel>
@{
    ViewData["Title"] = "Reports";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading mb-1">View Reports</h2>
            <p class="text-muted mb-0">View all reports generated by officers.</p>
        </div>
    </div>

    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-4" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card stat-card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" asp-controller="Report">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small text-muted text-uppercase">Filter by Officer</label>
                        <select name="officerFilter" class="form-select form-select-sm">
                            <option value="">All Officers</option>
                            @if (ViewBag.Officers != null)
                            {
                                @foreach (var officer in ViewBag.Officers)
                                {
                                    <option value="@officer.Id" selected="@(ViewBag.OfficerFilter == officer.Id)">
                                        @officer.FullName
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted text-uppercase">Filter by Type</label>
                        <select name="typeFilter" class="form-select form-select-sm">
                            <option value="">All Types</option>
                            <option value="Payments" selected="@(ViewBag.TypeFilter == "Payments")">Payments</option>
                            <option value="Customers" selected="@(ViewBag.TypeFilter == "Customers")">Customers</option>
                            <option value="Revenue" selected="@(ViewBag.TypeFilter == "Revenue")">Revenue</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-sm btn-dark-soft w-100">
                            <i class="fas fa-filter me-1"></i>Apply
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.OfficerFilter) || !string.IsNullOrEmpty(ViewBag.TypeFilter))
                {
                    <div class="mt-3 pt-3 border-top">
                        <a asp-action="Index" asp-controller="Report" class="text-muted small text-decoration-none">
                            <i class="fas fa-times-circle me-1"></i>Clear all filters
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body pb-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="heading mb-1">Generated Reports</h6>
                    <p class="text-muted small mb-0">@Model.Count() report@(Model.Count() == 1 ? "" : "s") found</p>
                </div>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <table class="table table-clean mb-0 w-100">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Generated By</th>
                        <th>Date Range</th>
                        <th>Generated Date</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model)
                    {
                        string typeBadge = report.ReportType switch
                        {
                            "Payments" => "badge-soft-green",
                            "Customers" => "badge-soft-blue",
                            "Revenue" => "badge-soft-yellow",
                            _ => "badge-soft-gray"
                        };

                        <tr>
                            <td>
                                <span class="@typeBadge">@report.ReportType</span>
                            </td>
                            <td class="text-muted">@report.GeneratedBy</td>
                            <td class="text-muted">@report.StartDate.ToString("dd MMM yyyy") - @report.EndDate.ToString("dd MMM yyyy")</td>
                            <td class="text-muted">@report.GeneratedDate.ToString("dd MMM yyyy, HH:mm")</td>
                            <td>
                                @if (report.Status == "Generated")
                                {
                                    <span class="badge-soft-green">Generated</span>
                                }
                                else
                                {
                                    <span class="badge-soft-gray">@report.Status</span>
                                }
                            </td>
                            <td class="text-nowrap text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-sm dropdown-menu-end">
                                        <a asp-action="Details" asp-route-id="@report.ReportId" class="dropdown-item">
                                            <i class="fas fa-eye me-2"></i>View Details
                                        </a>
                                        @if (!string.IsNullOrEmpty(report.FilePath))
                                        {
                                            <a asp-action="DownloadPdf" asp-route-id="@report.ReportId" class="dropdown-item">
                                                <i class="fas fa-download me-2"></i>Download PDF
                                            </a>
                                        }
                                        <div class="dropdown-divider"></div>
                                        <form asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('Delete this report?')">
                                            <input type="hidden" name="id" value="@report.ReportId" />
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fas fa-trash me-2"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-file-alt fa-2x text-muted mb-3"></i>
                <h6 class="heading mb-1">No Reports Found</h6>
                <p class="text-muted small mb-0">No reports have been generated yet.</p>
            </div>
        }
    </div>

</div>