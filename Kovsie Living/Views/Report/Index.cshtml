@model IEnumerable<ReportViewModel>
@{
    ViewData["Title"] = "Reports";
    Layout = "_DashboardLayout";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading display-6 m-0">Reports</h2>
            <p class="m-0 lead text-muted">View all reports generated by officers</p>
        </div>
    </div>

    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-3" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card px-4 py-2">
        <div class="card-header text-center border-bottom bg-white">
            <h6 class="m-0 pb-2">Generated Reports</h6>
        </div>
        <div class="card-body px-0 pb-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive-lg">
                    <table class="table table-bordered align-middle text-center">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Type</th>
                                <th>Generated By</th>
                                <th>Date Range</th>
                                <th>Generated Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in Model)
                            {
                                <tr>
                                    <td>@report.Title</td>
                                    <td><span class="badge bg-info">@report.ReportType</span></td>
                                    <td>@report.GeneratedBy</td>
                                    <td>@report.StartDate.ToString("dd MMM yyyy") - @report.EndDate.ToString("dd MMM yyyy")</td>
                                    <td>@report.GeneratedDate.ToString("dd MMM yyyy, HH:mm")</td>
                                    <td>
                                        <span class="badge @(report.Status == "Generated" ? "bg-success" : "bg-secondary")">
                                            @report.Status
                                        </span>
                                    </td>
                                    <td class="nav-item dropdown">
                                        <button class="btn btn-sm btn-outline-dark w-100 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                            Actions
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end">
                                            <a asp-action="Details" asp-route-id="@report.ReportId" class="dropdown-item">
                                                <i class="fas fa-eye me-2"></i>View
                                            </a>
                                            <a href="@report.FilePath" class="dropdown-item" target="_blank">
                                                <i class="fas fa-download me-2"></i>Download
                                            </a>
                                            <form asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('Delete this report?')">
                                                <input type="hidden" name="id" value="@report.ReportId" />
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="fas fa-trash me-2"></i>Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center border-top">
                    <i class="fas fa-file-alt fa-3x text-muted m-3"></i>
                    <h5 class="text-muted">No Reports Found</h5>
                    <p class="mb-3 text-muted">No reports have been generated yet.</p>
                </div>
            }

        </div>
    </div>

</div>