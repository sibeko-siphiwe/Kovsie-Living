@model ReportViewModel
@{
    ViewData["Title"] = "Report Details";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-4" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card stat-card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h4 class="heading mb-1">@Model.Title</h4>
                    <p class="text-muted small mb-0">
                        Generated by @Model.GeneratedBy on @Model.GeneratedDate.ToString("dd MMM yyyy, HH:mm")
                    </p>
                </div>
                <div class="d-flex gap-2">
                    @if (!string.IsNullOrEmpty(Model.FilePath))
                    {
                        <a asp-action="DownloadPdf" asp-route-id="@Model.ReportId" class="btn btn-sm btn-dark-soft">
                            <i class="fas fa-download me-1"></i>Download PDF
                        </a>
                    }
                    @if (User.IsInRole("Officer"))
                    {
                        <a asp-action="MyReports" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back
                        </a>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="text-muted small text-uppercase">Date Range</span>
                        <i class="fas fa-calendar text-muted"></i>
                    </div>
                    <p class="fw-semibold mb-0 small">
                        @Model.StartDate.ToString("dd MMM yyyy") - @Model.EndDate.ToString("dd MMM yyyy")
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="text-muted small text-uppercase">Status</span>
                        <i class="fas fa-check-circle text-muted"></i>
                    </div>
                    @if (Model.Status == "Generated")
                    {
                        <span class="badge-soft-green">@Model.Status</span>
                    }
                    else
                    {
                        <span class="badge-soft-gray">@Model.Status</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="text-muted small text-uppercase">Generated Date</span>
                        <i class="fas fa-clock text-muted"></i>
                    </div>
                    <p class="fw-semibold mb-0 small">@Model.GeneratedDate.ToString("dd MMM yyyy")</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="text-muted small text-uppercase">Description</span>
                        <i class="fas fa-file-alt text-muted"></i>
                    </div>
                    <p class="fw-semibold mb-0 small">
                        @(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div id="reportData"></div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            var reportDataJson = '@Html.Raw(ViewBag.ReportDataJson)';
            var reportType = '@ViewBag.ReportType';

            if (reportDataJson && reportDataJson !== '') {
                try {
                    var data = JSON.parse(reportDataJson);
                    renderReportData(reportType, data);
                } catch (e) {
                    console.error('Error parsing report data:', e);
                    document.getElementById('reportData').innerHTML = '<div class="alert alert-danger">Error loading report data</div>';
                }
            }
        });

        function renderReportData(type, data) {
            var container = document.getElementById('reportData');

            if (type === 'Customers') {
                renderCustomerReport(container, data);
            } else if (type === 'Payments') {
                renderPaymentReport(container, data);
            } else if (type === 'Revenue') {
                renderRevenueReport(container, data);
            }
        }

        function renderCustomerReport(container, data) {
            var html = '';

            html += '<div class="row g-2 mb-4">';
            html += createSummaryCard('col-md-6 col-lg-3', 'fa-users', 'Total Customers', data.TotalCustomers);
            html += createSummaryCard('col-md-6 col-lg-3', 'fa-check-circle', 'Approved', data.ApprovedCustomers);
            html += createSummaryCard('col-md-6 col-lg-3', 'fa-clock', 'Pending', data.PendingCustomers);
            html += createSummaryCard('col-md-6 col-lg-3', 'fa-money-bill', 'Total Collected', 'R ' + data.TotalCollected.toFixed(2));
            html += '</div>';

            html += '<div class="card stat-card">';
            html += '<div class="card-body pb-0"><h6 class="heading mb-3">Customer Details</h6></div>';
            html += '<table class="table table-clean mb-0 w-100">';
            html += '<thead><tr><th>Name</th><th>Type</th><th>Number</th><th>Unit</th><th>Status</th><th>Registered</th><th class="text-end">Total Paid</th></tr></thead>';
            html += '<tbody>';

            if (data.Customers && data.Customers.length > 0) {
                data.Customers.forEach(function (customer) {
                    html += '<tr>';
                    html += '<td class="fw-semibold">' + customer.FullName + '</td>';
                    html += '<td>' + customer.UserType + '</td>';
                    html += '<td class="text-muted">' + customer.UserNumber + '</td>';
                    html += '<td>' + customer.UnitNumber + '</td>';
                    html += '<td><span class="' + (customer.Status === 'Approved' ? 'badge-soft-green' : 'badge-soft-yellow') + '">' + customer.Status + '</span></td>';
                    html += '<td class="text-muted">' + formatDate(customer.RegistrationDate) + '</td>';
                    html += '<td class="fw-semibold text-end">R ' + customer.TotalPaid.toFixed(2) + '</td>';
                    html += '</tr>';
                });
            } else {
                html += '<tr><td colspan="7" class="text-muted text-center py-4">No customers found in this date range</td></tr>';
            }

            html += '</tbody></table></div>';

            container.innerHTML = html;
        }

        function renderPaymentReport(container, data) {
            var html = '';

            html += '<div class="row g-2 mb-4">';
            html += createSummaryCard('col-md-6 col-lg-3', 'fa-credit-card', 'Total Payments', data.TotalPayments);
            html += createSummaryCard('col-md-6 col-lg-3', 'fa-check-circle', 'Approved', data.ApprovedPayments);
            html += createSummaryCard('col-md-6 col-lg-3', 'fa-clock', 'Pending', data.PendingPayments);
            html += createSummaryCard('col-md-6 col-lg-3', 'fa-money-bill', 'Total Amount', 'R ' + data.TotalAmount.toFixed(2));
            html += '</div>';

            html += '<div class="card stat-card">';
            html += '<div class="card-body pb-0"><h6 class="heading mb-3">Payment Details</h6></div>';
            html += '<table class="table table-clean mb-0 w-100">';
            html += '<thead><tr><th>Customer</th><th>Service</th><th>Amount</th><th>Date</th><th>Status</th><th>Reference</th></tr></thead>';
            html += '<tbody>';

            if (data.Payments && data.Payments.length > 0) {
                data.Payments.forEach(function (payment) {
                    html += '<tr>';
                    html += '<td class="fw-semibold">' + payment.CustomerName + '</td>';
                    html += '<td>' + payment.TariffName + '</td>';
                    html += '<td class="fw-semibold">R ' + payment.Amount.toFixed(2) + '</td>';
                    html += '<td class="text-muted">' + formatDate(payment.PaymentDate) + '</td>';
                    html += '<td><span class="' + getStatusBadge(payment.Status) + '">' + payment.Status + '</span></td>';
                    html += '<td><code>' + payment.Reference + '</code></td>';
                    html += '</tr>';
                });
            } else {
                html += '<tr><td colspan="6" class="text-muted text-center py-4">No payments found in this date range</td></tr>';
            }

            html += '</tbody></table></div>';

            container.innerHTML = html;
        }

        function renderRevenueReport(container, data) {
            var html = '';

            html += '<div class="row g-2 mb-4">';
            html += createSummaryCard('col-md-4', 'fa-chart-line', 'Total Revenue', 'R ' + data.TotalRevenue.toFixed(2));
            html += createSummaryCard('col-md-4', 'fa-clock', 'Pending Revenue', 'R ' + data.PendingRevenue.toFixed(2));
            html += createSummaryCard('col-md-4', 'fa-exchange-alt', 'Transactions', data.TransactionCount);
            html += '</div>';

            html += '<div class="row g-2">';

            html += '<div class="col-lg-6">';
            html += '<div class="card stat-card h-100">';
            html += '<div class="card-body pb-0"><h6 class="heading mb-3">Revenue by Tariff</h6></div>';
            html += '<table class="table table-clean mb-0 w-100">';
            html += '<thead><tr><th>Service</th><th class="text-end">Amount</th></tr></thead><tbody>';

            if (data.RevenueByTariff && Object.keys(data.RevenueByTariff).length > 0) {
                Object.keys(data.RevenueByTariff).forEach(function (key) {
                    html += '<tr><td>' + key + '</td><td class="fw-semibold text-end">R ' + data.RevenueByTariff[key].toFixed(2) + '</td></tr>';
                });
            } else {
                html += '<tr><td colspan="2" class="text-muted text-center py-4">No data available</td></tr>';
            }

            html += '</tbody></table></div></div>';

            html += '<div class="col-lg-6">';
            html += '<div class="card stat-card h-100">';
            html += '<div class="card-body pb-0"><h6 class="heading mb-3">Monthly Breakdown</h6></div>';
            html += '<table class="table table-clean mb-0 w-100">';
            html += '<thead><tr><th>Month</th><th class="text-end">Amount</th></tr></thead><tbody>';

            if (data.MonthlyBreakdown && Object.keys(data.MonthlyBreakdown).length > 0) {
                Object.keys(data.MonthlyBreakdown).forEach(function (key) {
                    html += '<tr><td>' + key + '</td><td class="fw-semibold text-end">R ' + data.MonthlyBreakdown[key].toFixed(2) + '</td></tr>';
                });
            } else {
                html += '<tr><td colspan="2" class="text-muted text-center py-4">No data available</td></tr>';
            }

            html += '</tbody></table></div></div>';

            html += '</div>';

            container.innerHTML = html;
        }

        function createSummaryCard(colClass, icon, label, value) {
            return '<div class="' + colClass + '">' +
                '<div class="card stat-card h-100">' +
                '<div class="card-body">' +
                '<div class="d-flex justify-content-between align-items-start mb-3">' +
                '<span class="text-muted small text-uppercase">' + label + '</span>' +
                '<i class="fas ' + icon + ' text-muted"></i>' +
                '</div>' +
                '<h3 class="heading mb-0">' + value + '</h3>' +
                '</div>' +
                '</div>' +
                '</div>';
        }

        function formatDate(dateString) {
            var date = new Date(dateString);
            return date.toLocaleDateString('en-ZA', { day: '2-digit', month: 'short', year: 'numeric' });
        }

        function getStatusBadge(status) {
            if (status === 'Paid') return 'badge-soft-green';
            if (status === 'Pending') return 'badge-soft-yellow';
            if (status === 'Rejected') return 'badge-soft-red';
            return 'badge-soft-gray';
        }
    </script>
}