@model ReportViewModel
@{
    ViewData["Title"] = "Report Details";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-3">

    <!-- Alert Messages -->
    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-3" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="bg-dark text-light rounded-4 p-4 p-md-5 mb-4 shadow">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div> 
                <h2 class="heading display-6 m-0 mb-2">@Model.Title</h2>
                <p class="text-secondary m-0">Generated by @Model.GeneratedBy on @Model.GeneratedDate.ToString("dd MMM yyyy, HH:mm")</p>
            </div>
            <div class="d-flex gap-2">
                @if (!string.IsNullOrEmpty(Model.FilePath))
                {
                    <a asp-action="DownloadPdf" asp-route-id="@Model.ReportId" class="btn btn-light">
                        <i class="fas fa-download me-2"></i>Download PDF
                    </a>
                }
                @if (User.IsInRole("Officer"))
                {
                    <a asp-action="MyReports" class="btn btn-outline-light">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>
                }
                else
                {
                    <a asp-action="Index" class="btn btn-outline-light">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Report Info Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 d-inline-flex mb-2">
                        <i class="fas fa-calendar-alt fa-2x text-primary"></i>
                    </div>
                    <h6 class="text-muted mb-1">Date Range</h6>
                    <p class="fw-semibold m-0">@Model.StartDate.ToString("dd MMM yyyy") - @Model.EndDate.ToString("dd MMM yyyy")</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 d-inline-flex mb-2">
                        <i class="fas fa-check-circle fa-2x text-success"></i>
                    </div>
                    <h6 class="text-muted mb-1">Status</h6>
                    <span class="badge @(Model.Status == "Generated" ? "bg-success" : "bg-secondary") px-3 py-2">
                        @Model.Status
                    </span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 d-inline-flex mb-2">
                        <i class="fas fa-clock fa-2x text-info"></i>
                    </div>
                    <h6 class="text-muted mb-1">Generated Date</h6>
                    <p class="fw-semibold m-0">@Model.GeneratedDate.ToString("dd MMM yyyy")</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 d-inline-flex mb-2">
                        <i class="fas fa-file-alt fa-2x text-warning"></i>
                    </div>
                    <h6 class="text-muted mb-1">Description</h6>
                    <p class="fw-semibold m-0 small">@(string.IsNullOrEmpty(Model.Description) ? "No description" : Model.Description)</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Report Data -->
    <div id="reportData">
        <!-- Data will be rendered here by JavaScript -->
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var reportDataJson = '@Html.Raw(ViewBag.ReportDataJson)';
            var reportType = '@ViewBag.ReportType';

            if (reportDataJson && reportDataJson !== '') {
                try {
                    var data = JSON.parse(reportDataJson);
                    renderReportData(reportType, data);
                } catch (e) {
                    console.error('Error parsing report data:', e);
                    $('#reportData').html('<div class="alert alert-danger">Error loading report data</div>');
                }
            }
        });

        function renderReportData(type, data) {
            var container = $('#reportData');

            if (type === 'Customers') {
                renderCustomerReport(container, data);
            } else if (type === 'Payments') {
                renderPaymentReport(container, data);
            } else if (type === 'Revenue') {
                renderRevenueReport(container, data);
            }
        }

        function renderCustomerReport(container, data) {
            var html = '';

            // Summary Cards
            html += '<div class="row g-3 mb-4">';
            html += createSummaryCard('col-md-3', 'bg-primary', 'fa-users', 'Total Customers', data.TotalCustomers, 'text-primary');
            html += createSummaryCard('col-md-3', 'bg-success', 'fa-check-circle', 'Approved', data.ApprovedCustomers, 'text-success');
            html += createSummaryCard('col-md-3', 'bg-warning', 'fa-clock', 'Pending', data.PendingCustomers, 'text-warning');
            html += createSummaryCard('col-md-3', 'bg-info', 'fa-money-bill', 'Total Collected', 'R ' + data.TotalCollected.toFixed(2), 'text-info');
            html += '</div>';

            // Customer Table
            html += '<div class="card border-0 shadow-sm">';
            html += '<div class="card-header bg-white border-bottom"><h6 class="m-0 fw-semibold"><i class="fas fa-users me-2"></i>Customer Details</h6></div>';
            html += '<div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle text-center mb-0">';
            html += '<thead class="table-light"><tr><th>Name</th><th>Type</th><th>Number</th><th>Unit</th><th>Status</th><th>Registered</th><th>Total Paid</th></tr></thead>';
            html += '<tbody>';

            if (data.Customers && data.Customers.length > 0) {
                data.Customers.forEach(function (customer) {
                    html += '<tr>';
                    html += '<td class="fw-semibold">' + customer.FullName + '</td>';
                    html += '<td>' + customer.UserType + '</td>';
                    html += '<td>' + customer.UserNumber + '</td>';
                    html += '<td>' + customer.UnitNumber + '</td>';
                    html += '<td><span class="badge ' + (customer.Status === 'Approved' ? 'bg-success' : 'bg-warning text-dark') + ' px-3 py-2">' + customer.Status + '</span></td>';
                    html += '<td>' + formatDate(customer.RegistrationDate) + '</td>';
                    html += '<td class="fw-semibold">R ' + customer.TotalPaid.toFixed(2) + '</td>';
                    html += '</tr>';
                });
            } else {
                html += '<tr><td colspan="7" class="text-muted py-4">No customers found in this date range</td></tr>';
            }

            html += '</tbody></table></div></div></div>';

            container.html(html);
        }

        function renderPaymentReport(container, data) {
            var html = '';

            // Summary Cards
            html += '<div class="row g-3 mb-4">';
            html += createSummaryCard('col-md-3', 'bg-primary', 'fa-credit-card', 'Total Payments', data.TotalPayments, 'text-primary');
            html += createSummaryCard('col-md-3', 'bg-success', 'fa-check-circle', 'Approved', data.ApprovedPayments, 'text-success');
            html += createSummaryCard('col-md-3', 'bg-warning', 'fa-clock', 'Pending', data.PendingPayments, 'text-warning');
            html += createSummaryCard('col-md-3', 'bg-info', 'fa-money-bill', 'Total Amount', 'R ' + data.TotalAmount.toFixed(2), 'text-info');
            html += '</div>';

            // Payment Table
            html += '<div class="card border-0 shadow-sm">';
            html += '<div class="card-header bg-white border-bottom"><h6 class="m-0 fw-semibold"><i class="fas fa-credit-card me-2"></i>Payment Details</h6></div>';
            html += '<div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle text-center mb-0">';
            html += '<thead class="table-light"><tr><th>Customer</th><th>Service</th><th>Amount</th><th>Date</th><th>Status</th><th>Reference</th></tr></thead>';
            html += '<tbody>';

            if (data.Payments && data.Payments.length > 0) {
                data.Payments.forEach(function (payment) {
                    html += '<tr>';
                    html += '<td class="fw-semibold">' + payment.CustomerName + '</td>';
                    html += '<td>' + payment.TariffName + '</td>';
                    html += '<td class="fw-semibold">R ' + payment.Amount.toFixed(2) + '</td>';
                    html += '<td>' + formatDate(payment.PaymentDate) + '</td>';
                    html += '<td><span class="badge ' + getStatusBadge(payment.Status) + ' px-3 py-2">' + payment.Status + '</span></td>';
                    html += '<td><code>' + payment.Reference + '</code></td>';
                    html += '</tr>';
                });
            } else {
                html += '<tr><td colspan="6" class="text-muted py-4">No payments found in this date range</td></tr>';
            }

            html += '</tbody></table></div></div></div>';

            container.html(html);
        }

        function renderRevenueReport(container, data) {
            var html = '';

            // Summary Cards
            html += '<div class="row g-3 mb-4">';
            html += createSummaryCard('col-md-4', 'bg-success', 'fa-chart-line', 'Total Revenue', 'R ' + data.TotalRevenue.toFixed(2), 'text-success');
            html += createSummaryCard('col-md-4', 'bg-warning', 'fa-clock', 'Pending Revenue', 'R ' + data.PendingRevenue.toFixed(2), 'text-warning');
            html += createSummaryCard('col-md-4', 'bg-primary', 'fa-exchange-alt', 'Transactions', data.TransactionCount, 'text-primary');
            html += '</div>';

            html += '<div class="row g-3">';

            // Revenue by Tariff
            html += '<div class="col-md-6">';
            html += '<div class="card border-0 shadow-sm h-100">';
            html += '<div class="card-header bg-white border-bottom"><h6 class="m-0 fw-semibold"><i class="fas fa-tags me-2"></i>Revenue by Tariff</h6></div>';
            html += '<div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle text-center mb-0">';
            html += '<thead class="table-light"><tr><th>Service</th><th>Amount</th></tr></thead><tbody>';

            if (data.RevenueByTariff && Object.keys(data.RevenueByTariff).length > 0) {
                Object.keys(data.RevenueByTariff).forEach(function (key) {
                    html += '<tr><td>' + key + '</td><td class="fw-semibold">R ' + data.RevenueByTariff[key].toFixed(2) + '</td></tr>';
                });
            } else {
                html += '<tr><td colspan="2" class="text-muted py-4">No data available</td></tr>';
            }

            html += '</tbody></table></div></div></div></div>';

            // Monthly Breakdown
            html += '<div class="col-md-6">';
            html += '<div class="card border-0 shadow-sm h-100">';
            html += '<div class="card-header bg-white border-bottom"><h6 class="m-0 fw-semibold"><i class="fas fa-calendar me-2"></i>Monthly Breakdown</h6></div>';
            html += '<div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle text-center mb-0">';
            html += '<thead class="table-light"><tr><th>Month</th><th>Amount</th></tr></thead><tbody>';

            if (data.MonthlyBreakdown && Object.keys(data.MonthlyBreakdown).length > 0) {
                Object.keys(data.MonthlyBreakdown).forEach(function (key) {
                    html += '<tr><td>' + key + '</td><td class="fw-semibold">R ' + data.MonthlyBreakdown[key].toFixed(2) + '</td></tr>';
                });
            } else {
                html += '<tr><td colspan="2" class="text-muted py-4">No data available</td></tr>';
            }

            html += '</tbody></table></div></div></div></div>';
            html += '</div>';

            container.html(html);
        }

        function createSummaryCard(colClass, bgClass, icon, label, value, textClass) {
            return '<div class="' + colClass + '">' +
                '<div class="card border-0 shadow-sm h-100">' +
                '<div class="card-body">' +
                '<div class="d-flex align-items-center">' +
                '<div class="rounded-3 bg-' + bgClass + ' bg-opacity-10 p-3 me-3">' +
                '<i class="fas ' + icon + ' fa-lg ' + textClass + '"></i>' +
                '</div>' +
                '<div>' +
                '<h6 class="text-muted mb-1">' + label + '</h6>' +
                '<h4 class="mb-0 ' + textClass + '">' + value + '</h4>' +
                '</div>' +
                '</div>' +
                '</div>' +
                '</div>' +
                '</div>';
        }

        function formatDate(dateString) {
            var date = new Date(dateString);
            return date.toLocaleDateString('en-ZA', { day: '2-digit', month: 'short', year: 'numeric' });
        }

        function getStatusBadge(status) {
            if (status === 'Paid') return 'bg-success';
            if (status === 'Pending') return 'bg-warning text-dark';
            if (status === 'Rejected') return 'bg-danger';
            return 'bg-secondary';
        }
    </script>
}