@model IEnumerable<Notification>
@{
    ViewData["Title"] = "Notifications";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading mb-1">All Notifications</h2>
            <p class="text-muted mb-0">Your full system activity log.</p>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var notif in Model)
                    {
                        string icon = "fa-info-circle text-info";
                        if (notif.Type == "success") icon = "fa-check-circle text-success";
                        if (notif.Type == "warning") icon = "fa-exclamation-triangle text-warning";

                        <div class="list-group-item d-flex gap-3 py-4 px-4 border-bottom">
                            <i class="fas @icon mt-1 fs-4"></i>
                            <div>
                                <p class="mb-1 text-dark">@notif.Message</p>
                                <small class="text-muted"><i class="far fa-clock me-1"></i>@notif.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-bell-slash fa-2x text-muted mb-3"></i>
                    <h6 class="heading mb-1">No Notifications</h6>
                    <p class="text-muted small mb-0">You're all caught up!</p>
                </div>
            }
        </div>
    </div>
</div>