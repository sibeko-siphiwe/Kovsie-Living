@{
    ViewData["Title"] = "Financial Officers";
    Layout = "_DashboardLayout";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between flex-wrap gap-2 align-items-end mb-4">
        <div>
            <h2 class="heading display-6">Manage Officers</h2>
            <p class="m-0 text-muted lead">Manage financial officer accounts and assign authority</p>
        </div>
        <a asp-action="Create" asp-controller="Officer" class="btn btn-sm btn-dark"><i class="fas fa-add me-2"></i>Add New Officer</a>
    </div>

    @if (TempData["message"] != null)
    {
        <div class="alert alert-danger">
            <p class="m-0">@TempData["message"]</p>
        </div>
    }

    <div class="mb-4">
        <div class="p-3 bg-white shadow-sm rounded">
            <form method="get" asp-action="Officer">
                <div class="row g-2">
                    <div class="col-md-5">
                        <input name="searchTerm" placeholder="Search officer by name" class="form-control form-control-sm" value="@ViewBag.SearchTerm" />
                    </div>
                    <div class="col-md-4">
                        <select name="statusFilter" class="form-select form-select-sm">
                            <option value="">All Status</option>
                            <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Active</option>
                            <option value="Inactive" selected="@(ViewBag.StatusFilter == "Inactive")">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-sm btn-dark w-100">
                            <i class="fas fa-filter me-2"></i>Filter
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="mb-4">
        <div class="p-3 border rounded shadow-sm">
            <h6 class="mb-2">Assigned Officers</h6>
            <div class="p-5 text-center border-top">
                <i class="fas fa-user-shield fa-3x text-muted m-3"></i>
                <h5 class="text-muted">No Officers Found</h5>
                <p class="mb-3 text-muted">Try adjusting your search filters or add new officers</p>
            </div>
            @* @if (Model.Any())
            {
                <div class="table-responsive-lg">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Full Name</th>
                                <th>Employee Number</th>
                                <th>Phone Number</th>
                                <th>Email Address</th>
                                <th>Status</th>
                                <th>Authorized</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model)
                            {
                                <tr>
                                    <td>@u.FullName</td>
                                    <td>@(u.FinancialOfficer != null ? u.FinancialOfficer.EmployeeNumber : "N/A")</td>
                                    <td>@(u.FinancialOfficer != null ? u.FinancialOfficer.PhoneNumber : "N/A")</td>
                                    <td>@u.Email</td>
                                    <td>
                                        @if (u.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.FinancialOfficer != null && u.FinancialOfficer.IsAuthorized)
                                        {
                                            <span class="badge bg-success">Authorized</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-dark w-100 dropdown-toggle" type="button" id="dropdown-@u.Id" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                Actions
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdown-@u.Id">
                                                <a asp-action="Details" asp-controller="Users" asp-route-id="@u.Id" class="dropdown-item">
                                                    <i class="fas fa-eye me-2"></i>View Details
                                                </a>
                                                @if (u.FinancialOfficer != null && !u.FinancialOfficer.IsAuthorized)
                                                {
                                                    <form asp-action="Authorize" asp-controller="Officer" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to authorize this officer?')">
                                                        <input type="hidden" name="id" value="@u.Id" />
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="fas fa-check me-2"></i>Authorize Officer
                                                        </button>
                                                    </form>
                                                }
                                                @if (u.FinancialOfficer != null && u.FinancialOfficer.IsAuthorized)
                                                {
                                                    <form asp-action="Revoke" asp-controller="Officer" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to revoke authorization?')">
                                                        <input type="hidden" name="id" value="@u.Id" />
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="fas fa-times me-2"></i>Revoke Authorization
                                                        </button>
                                                    </form>
                                                }
                                                <form asp-action="Delete" asp-controller="Users" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to delete this officer?')">
                                                    <input type="hidden" name="id" value="@u.Id" />
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="fas fa-trash me-2"></i>Delete Officer
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center border-top">
                    <i class="fas fa-user-shield fa-3x text-muted m-3"></i>
                    <h5 class="text-muted">No Officers Found</h5>
                    <p class="mb-3 text-muted">Try adjusting your search filters or add new officers</p>
                </div>
            } *@
        </div>
    </div>

</div>