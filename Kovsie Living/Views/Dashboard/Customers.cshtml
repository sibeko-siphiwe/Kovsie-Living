@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Customer Management";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading mb-1">Manage Customers</h2>
            <p class="text-muted mb-0">View and manage all registered customers.</p>
        </div>
        <a asp-action="Create" asp-controller="Customer" class="btn btn-sm btn-dark-soft">
            <i class="fas fa-plus me-1"></i>New Customer
        </a>
    </div>

    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-4" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card stat-card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Customers" asp-controller="Dashboard">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small text-muted text-uppercase">Search</label>
                        <input name="searchTerm" placeholder="Search by name, username, or email..."
                               class="form-control form-control-sm" value="@ViewBag.SearchTerm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted text-uppercase">User Type</label>
                        <select name="userTypeFilter" class="form-select form-select-sm">
                            <option value="">All Types</option>
                            <option value="Student" selected="@(ViewBag.UserTypeFilter == "Student")">Student</option>
                            <option value="Staff" selected="@(ViewBag.UserTypeFilter == "Staff")">Staff</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted text-uppercase">Status</label>
                        <select name="statusFilter" class="form-select form-select-sm">
                            <option value="">All</option>
                            <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Active</option>
                            <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Pending</option>
                            <option value="Inactive" selected="@(ViewBag.StatusFilter == "Inactive")">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-sm btn-dark-soft w-100">
                            <i class="fas fa-filter me-1"></i>Apply
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm) ||
                                !string.IsNullOrEmpty(ViewBag.UserTypeFilter) ||
                                !string.IsNullOrEmpty(ViewBag.StatusFilter))
                {
                    <div class="mt-3 pt-3 border-top">
                        <a asp-action="Customers" asp-controller="Dashboard" class="text-muted small text-decoration-none">
                            <i class="fas fa-times-circle me-1"></i>Clear all filters
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body pb-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="heading mb-1">Registered Users</h6>
                    <p class="text-muted small mb-0">@Model.Count() customer@(Model.Count() == 1 ? "" : "s") found</p>
                </div>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <table class="table table-clean mb-0 w-100">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Username</th>
                        <th>User Type</th>
                        <th>Unit Number</th>
                        <th>Approval</th>
                        <th>Account Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var isStudent = user.Student != null;
                        var isStaff = user.Staff != null;
                        var isApproved = isStudent ? (user.Student?.IsApproved ?? false) :
                        (isStaff ? (user.Staff?.IsApproved ?? false) : true);

                        <tr>
                            <td class="fw-semibold">@user.FullName</td>
                            <td class="text-muted">@user.UserName</td>
                            <td>
                                @if (isStudent)
                                {
                                    <span class="badge-soft-blue">Student</span>
                                }
                                else if (isStaff)
                                {
                                    <span class="badge-soft-purple">Staff</span>
                                }
                                else
                                {
                                    <span class="badge-soft-gray">Unknown</span>
                                }
                            </td>
                            <td>
                                @if (isStudent)
                                {
                                    @user.Student?.UnitNumber
                                }
                                else if (isStaff)
                                {
                                    @user.Staff?.UnitNumber
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>
                                @if (isApproved)
                                {
                                    <span class="badge-soft-green">Approved</span>
                                }
                                else
                                {
                                    <span class="badge-soft-yellow">Pending</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge-soft-green">Active</span>
                                }
                                else
                                {
                                    <span class="badge-soft-red">Inactive</span>
                                }
                            </td>
                            <td class="text-nowrap text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-sm dropdown-menu-end">
                                        <a asp-action="Details" asp-controller="Customer" asp-route-id="@user.Id" class="dropdown-item">
                                            <i class="fas fa-eye me-2"></i>View
                                        </a>
                                        <a asp-action="Update" asp-controller="Customer" asp-route-id="@user.Id" class="dropdown-item">
                                            <i class="fas fa-pen me-2"></i>Edit
                                        </a>
                                        <a asp-action="ChangePassword" asp-controller="Customer" asp-route-id="@user.Id" class="dropdown-item">
                                            <i class="fas fa-key me-2"></i>Password
                                        </a>

                                        @if (isStudent || isStaff)
                                        {
                                            <div class="dropdown-divider"></div>
                                            <form asp-action="ToggleApproval" asp-controller="Customer" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="dropdown-item">
                                                    <i class="fas @(isApproved ? "fa-circle-xmark" : "fa-circle-check") me-2"></i>
                                                    @(isApproved ? "Unapprove" : "Approve")
                                                </button>
                                            </form>
                                        }

                                        @if (User.IsInRole("Administrator"))
                                        {
                                            <form asp-action="ToggleActive" asp-controller="Customer" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="dropdown-item">
                                                    <i class="fas @(user.IsActive ? "fa-circle-pause" : "fa-circle-play") me-2"></i>
                                                    @(user.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                            <div class="dropdown-divider"></div>
                                            <form asp-action="Delete" asp-controller="Customer" method="post" class="m-0" onsubmit="return confirm('Delete this user?')">
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="fas fa-trash me-2"></i>Delete
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-user-alt fa-2x text-muted mb-3"></i>
                <h6 class="heading mb-1">No Customers Yet</h6>
                <p class="text-muted small mb-3">Registered customers will appear here.</p>
                <a asp-action="Create" asp-controller="Customer" class="btn btn-sm btn-dark-soft">
                    <i class="fas fa-plus me-1"></i>Create First Customer
                </a>
            </div>
        }
    </div>

</div>