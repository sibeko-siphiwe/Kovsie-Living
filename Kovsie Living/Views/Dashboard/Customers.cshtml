@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Customer Management";
    Layout = "_DashboardLayout";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading display-6 m-0">Manage Customers</h2>
            <p class="m-0 lead text-muted">Manage all registered customers and their estate accounts</p>
        </div>
        <a asp-action="Create" asp-controller="Customer" class="btn btn-sm btn-dark">
            <i class="fas fa-user-plus me-2"></i>Create New Customer
        </a>
    </div>

    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-3" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="mb-4">
        <div class="p-3 bg-white shadow-sm rounded">
            <form method="get" asp-action="Customers" asp-controller="Dashboard">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Search</label>
                        <input name="searchTerm" placeholder="Search by name, username, or email..."
                               class="form-control form-control-sm" value="@ViewBag.SearchTerm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">User Type</label>
                        <select name="userTypeFilter" class="form-select-sm form-select">
                            <option value="">All Types</option>
                            <option value="Student" selected="@(ViewBag.UserTypeFilter == "Student")">Student</option>
                            <option value="Staff" selected="@(ViewBag.UserTypeFilter == "Staff")">Staff</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Status</label>
                        <select name="statusFilter" class="form-select-sm form-select">
                            <option value="">All Status</option>
                            <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Active</option>
                            <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Pending</option>
                            <option value="Inactive" selected="@(ViewBag.StatusFilter == "Inactive")">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-sm btn-dark w-100">
                            <i class="fas fa-filter me-2"></i>Apply Filter
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm) ||
                                !string.IsNullOrEmpty(ViewBag.UserTypeFilter) ||
                                !string.IsNullOrEmpty(ViewBag.StatusFilter))
                {
                    <div class="mt-2">
                        <a asp-action="Customers" asp-controller="Dashboard" class="text-muted small">
                            <i class="fas fa-times-circle me-1"></i>Clear all filters
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <div class="card px-4 py-2">
        <div class="card-header text-center border-bottom bg-white">
            <h6 class="m-0 pb-2">Registered Users</h6>
        </div>
        <div class="card-body px-0 pb-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive-lg">
                    <table class="table table-bordered align-middle text-center">
                        <thead class="table-light">
                            <tr>
                                <th>Full Name</th>
                                <th>Username</th>
                                <th>Email Address</th>
                                <th>User Type</th>
                                <th>Unit Number</th>
                                <th>Approval</th>
                                <th>Account Status</th> 
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                var isStudent = user.Student != null;
                                var isStaff = user.Staff != null;
                                var isApproved = isStudent ? (user.Student?.IsApproved ?? false) :
                                (isStaff ? (user.Staff?.IsApproved ?? false) : true);

                                <tr>
                                    <td>@user.FullName</td>
                                    <td>@user.UserName</td>
                                    <td>@user.Email</td>
                                    <td>
                                        @if (isStudent)
                                        {
                                            <span class="badge bg-primary">Student</span>
                                        }
                                        else if (isStaff)
                                        {
                                            <span class="badge bg-info text-dark">Staff</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Unknown</span>
                                        }
                                    </td>
                                    <td>
                                        @if (isStudent)
                                        {
                                            @user.Student?.UnitNumber
                                        }
                                        else if (isStaff)
                                        {
                                            @user.Staff?.UnitNumber
                                        }
                                        else
                                        {
                                            @:N/A
                                        }
                                    </td>
                                    <td>
                                        @if (isApproved)
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td> 
                                    <td class="nav-item dropdown">
                                        <button class="btn btn-sm btn-outline-dark w-100 dropdown-toggle" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            Actions
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenu2">
                                            <a asp-action="Details" asp-controller="Customer" asp-route-id="@user.Id" class="dropdown-item">
                                                <i class="fas fa-eye me-2"></i>View User
                                            </a>
                                            <a asp-action="Update" asp-controller="Customer" asp-route-id="@user.Id" class="dropdown-item">
                                                <i class="fas fa-edit me-2"></i>Update User
                                            </a>
                                            <a asp-action="ChangePassword" asp-controller="Customer" asp-route-id="@user.Id" class="dropdown-item">
                                                <i class="fas fa-lock me-2"></i>Change Password
                                            </a>

                                            @if (isStudent || isStaff)
                                            {
                                                <form asp-action="ToggleApproval" asp-controller="Customer" method="post" class="m-0">
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button type="submit" class="dropdown-item">
                                                        <i class="fas @(isApproved ? "fa-times-circle" : "fa-check-circle") me-2"></i>
                                                        @(isApproved ? "Unapprove" : "Approve") User
                                                    </button>
                                                </form>
                                            }

                                            @if (User.IsInRole("Administrator"))
                                            {
                                                <form asp-action="ToggleActive" asp-controller="Customer" method="post" class="m-0">
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button type="submit" class="dropdown-item">
                                                        <i class="fas @(user.IsActive ? "fa-pause-circle" : "fa-play-circle") me-2"></i>
                                                        @(user.IsActive ? "Deactivate" : "Activate") User
                                                    </button>
                                                </form>

                                                <form asp-action="Delete" asp-controller="Customer" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to delete this user?')">
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="fas fa-trash me-2"></i>Delete User
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center">
                    <i class="fas fa-user-alt fa-3x text-muted m-3"></i>
                    <h5 class="text-muted">No Active Users Yet</h5>
                    <p class="mb-3 text-muted">Registered Customers will appear down here !</p>
                </div>
            }
        </div>
    </div>

</div>