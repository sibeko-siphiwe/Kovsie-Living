@model DashboardViewModel
@{
    ViewData["Title"] = "System Dashboard";
    Layout = "_DashboardLayout";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 g-2 mb-4">
        @if (User.IsInRole("Administrator") || User.IsInRole("Officer"))
        {
            <div>
                <h2 class="heading display-6 m-0">System Dashboard</h2>
                <p class="m-0 lead text-muted">Manage the estate payment with ease from this dashboard.</p>
            </div>
        }

        <div class="d-flex gap-2">
            @if (User.IsInRole("Administrator"))
            {
                <a asp-action="Index" asp-controller="Report" class="btn btn-sm btn-outline-dark"><i class="fas fa-file-pdf me-2"></i>View Reports</a>
                <a asp-action="Create" asp-controller="Customer" class="btn btn-sm btn-dark"><i class="fas fa-add me-2"></i>Create New User</a>
            }

            @if (User.IsInRole("Officer"))
            {
                <a class="btn btn-sm btn-outline-dark"><i class="fas fa-file-pdf me-2"></i>Generate Report</a>
                <a asp-action="Create" asp-controller="Customer" class="btn btn-sm btn-dark"><i class="fas fa-add me-2"></i>Create New User</a>
            }
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="mb-4">
        <div class="row gap-2 g-2">

            @if (User.IsInRole("Administrator") || User.IsInRole("Officer"))
            {
                <div class="col-md">
                    <div class="p-3 border rounded">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="mb-1">Total Customers</h6>
                                <h2 class="mb-1">@Model.Users.Count()</h2>
                                <p class="text-muted small m-0">Active Customers</p>
                            </div>
                            <div class="border border-info bg-info bg-opacity-10 p-2 rounded shadow-sm">
                                <i class="fas fa-users text-info"></i>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (User.IsInRole("Administrator"))
            {
                <div class="col-md">
                    <div class="p-3 border rounded">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="mb-1">Total Officers</h6>
                                <h2 class="mb-1">@Model.Officers.Count()</h2>
                                <p class="text-muted small m-0">Active Financial Officers</p>
                            </div>
                            <div class="border border-secondary bg-secondary bg-opacity-10 p-2 rounded shadow-sm">
                                <i class="fas fa-user-shield text-secondary"></i>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (User.IsInRole("Officer"))
            {
                @if (User.IsInRole("Officer"))
                {
                    <div class="col-md">
                        <div class="p-3 border rounded">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="mb-1">Total Revenue</h6>
                                    <h2 class="mb-1">R @Model.TotalRevenue.ToString("N2")</h2>
                                    <p class="text-muted small m-0">Total collected to date</p>
                                </div>
                                <div class="border border-success bg-success bg-opacity-10 p-2 rounded shadow-sm">
                                    <i class="fas fa-money-bill text-success"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

            <div class="col-md">
                <div class="p-3 border rounded">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="mb-1">Pending Payments</h6>
                            <h2 class="mb-1">@Model.PendingPaymentsCount</h2>
                            <p class="text-muted small m-0">Awaiting processing</p>
                        </div>
                        <div class="border border-warning bg-warning bg-opacity-10 p-2 rounded shadow-sm">
                            <i class="fas fa-clock-four text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="mb-4">
        <div class="row gap-2 g-2">
            <!-- CHART 1: Payment Distribution by Tariff -->
            <div class="col-md">
                <div class="card">
                    <div class="card-header text-center border-0 bg-white">
                        <h6>Payment Distribution by Tariff</h6>
                    </div>
                    <div class="card-body">
                        <div style="position: relative; height: 250px;">
                            <canvas id="paymentDistributionChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CHART 2: User Approval Status -->
            <div class="col-md">
                <div class="card">
                    <div class="card-header text-center border-0 bg-white">
                        <h6>User Approval Status</h6>
                    </div>
                    <div class="card-body">
                        <div style="position: relative; height: 250px;">
                            <canvas id="userApprovalChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- User Table (Admin Only) -->
    @if (User.IsInRole("Administrator"))
    {
        <div class="mb-4">
            <div class="card px-4 py-2">
                <div class="card-header text-center border-bottom bg-white">
                    <h6 class="m-0 pb-2">Registered Users</h6>
                </div>
                <div class="card-body px-0 pb-0">
                    @if (Model.Users.Any())
                    {
                        <div class="table-responsive-lg">
                            <table class="table table-bordered align-middle text-center">
                                <thead class="table-light">
                                    <tr>
                                        <th>Full Name</th>
                                        <th>Email Address</th>
                                        <th>Unit Number</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in Model.Users.Take(5))
                                    {
                                        <tr>
                                            <td>@u.FullName</td>
                                            <td>@u.Email</td>
                                            <td>
                                                @if (u.Student != null)
                                                {
                                                    @u.Student.UnitNumber
                                                }
                                                else if (u.Staff != null)
                                                {
                                                    @u.Staff.UnitNumber
                                                }
                                                else
                                                {
                                                    @:N/A
                                                }
                                            </td>
                                            <td>
                                                @if (u.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Inactive</span>
                                                }
                                            </td>
                                            <td class="nav-item dropdown">
                                                <button class="btn btn-sm btn-outline-dark w-100 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                    Actions
                                                </button>
                                                <div class="dropdown-menu dropdown-menu-end">
                                                    <a asp-action="Details" asp-controller="Customer" asp-route-id="@u.Id" class="dropdown-item">
                                                        <i class="fas fa-eye me-2"></i>View User
                                                    </a>
                                                    <a asp-action="Update" asp-controller="Customer" asp-route-id="@u.Id" class="dropdown-item">
                                                        <i class="fas fa-edit me-2"></i>Update User
                                                    </a>
                                                    <a asp-action="ChangePassword" asp-controller="Customer" asp-route-id="@u.Id" class="dropdown-item">
                                                        <i class="fas fa-lock me-2"></i>Change Password
                                                    </a>
                                                    <form asp-action="Delete" asp-controller="Customer" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to delete this user?')">
                                                        <input type="hidden" name="id" value="@u.Id" />
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="fas fa-trash me-2"></i>Delete User
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        if (Model.Users.Count() > 5)
                        {
                            <div class="text-center mt-2">
                                <a asp-action="Customers" asp-controller="Dashboard" class="btn btn-sm btn-outline-dark">View All Users</a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-5 text-center">
                            <i class="fas fa-user-alt fa-3x text-muted m-3"></i>
                            <h5 class="text-muted">No Active Users Yet</h5>
                            <p class="mb-3 text-muted">Registered Customers will appear down here !</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Recent Transactions (Admin & Officer) -->
    @if (User.IsInRole("Officer"))
    {
        <div>
            <div class="card px-4 py-2">
                <div class="card-header text-center border-bottom bg-white">
                    <h6 class="m-0 pb-2">Recent Transactions</h6>
                </div>
                <div class="card-body px-0 pb-0">

                    @if (Model.RecentPayments != null && Model.RecentPayments.Any())
                    {
                        <div class="table-responsive-lg">
                            <table class="table table-bordered align-middle text-center">
                                <thead class="table-light">
                                    <tr>
                                        <th>Customer</th>
                                        <th>Service</th>
                                        <th>Amount</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in Model.RecentPayments)
                                    {
                                        string statusBadge;
                                        string statusColor;
                                        if (payment.Status == "Paid")
                                        {
                                            statusBadge = "Paid";
                                            statusColor = "bg-success";
                                        }
                                        else if (payment.Status == "Pending")
                                        {
                                            statusBadge = "Pending";
                                            statusColor = "bg-warning text-dark";
                                        }
                                        else if (payment.Status == "Rejected")
                                        {
                                            statusBadge = "Rejected";
                                            statusColor = "bg-danger";
                                        }
                                        else
                                        {
                                            statusBadge = payment.Status;
                                            statusColor = "bg-secondary";
                                        }

                                        <tr>
                                            <td>@payment.User?.FullName</td>
                                            <td>@payment.Tariff?.Name</td>
                                            <td>R @payment.Amount.ToString("N2")</td>
                                            <td>@payment.PaymentDate.ToString("dd MMM yyyy, HH:mm")</td>
                                            <td>
                                                <span class="badge @statusColor">@statusBadge</span>
                                            </td>
                                            <td>
                                                @if (payment.Status == "Pending")
                                                {
                                                    <div class="d-flex gap-1 justify-content-center">
                                                        <form asp-action="ApprovePayment" method="post" class="m-0">
                                                            <input type="hidden" name="id" value="@payment.PaymentId" />
                                                            <button type="submit" class="btn btn-sm btn-success" title="Approve">
                                                                <i class="fas fa-check"></i>
                                                            </button>
                                                        </form>
                                                        <form asp-action="RejectPayment" method="post" class="m-0">
                                                            <input type="hidden" name="id" value="@payment.PaymentId" />
                                                            <button type="submit" class="btn btn-sm btn-danger" title="Reject" onclick="return confirm('Reject this payment?')">
                                                                <i class="fas fa-times"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        if (Model.RecentPayments.Count() >= 10)
                        {
                            <div class="text-center mt-2">
                                <a asp-action="Pending" asp-controller="Payment" class="btn btn-sm btn-outline-dark">View All Pending</a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-5 text-center">
                            <i class="fas fa-receipt fa-3x text-muted m-3"></i>
                            <h5 class="text-muted">No Recent Transactions</h5>
                            <p class="mb-3 text-muted">All transactions will show here.</p>
                        </div>
                    }

                </div>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {

            // ==========================================
            // CHART 1: Payment Distribution by Tariff (Doughnut)
            // ==========================================
            var ctx1 = document.getElementById('paymentDistributionChart').getContext('2d');

            var tariffNames = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Tariffs.Select(t => t.Name)));
            var tariffAmounts = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Tariffs.Select(t => t.Amount)));

            var colors = [
                '#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b',
                '#858796', '#5a5c69', '#2d2d2d', '#6f42c1', '#fd7e14'
            ];

            new Chart(ctx1, {
                type: 'doughnut',
                data: {
                    labels: tariffNames,
                    datasets: [{
                        data: tariffAmounts,
                        backgroundColor: colors.slice(0, tariffNames.length),
                        borderWidth: 3,
                        borderColor: '#ffffff',
                        hoverOffset: 15
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 20,
                                usePointStyle: true,
                                pointStyle: 'circle',
                                font: {
                                    size: 13,
                                    weight: 'bold'
                                }
                            }
                        }
                    }
                }
            });

            // ==========================================
            // CHART 2: User Approval Status (Bar Chart)
            // ==========================================
            var ctx2 = document.getElementById('userApprovalChart').getContext('2d');

            new Chart(ctx2, {
                type: 'bar',
                data: {
                    labels: ['Approved', 'Pending'],
                    datasets: [{
                        label: 'Users',
                        data: [@Model.ApprovedUsers, @Model.PendingUsers],
                        backgroundColor: [
                            'rgba(25, 135, 84, 0.8)',
                            'rgba(255, 193, 7, 0.8)'
                        ],
                        borderColor: ['#198754', '#ffc107'],
                        borderWidth: 2,
                        borderRadius: 8,
                        barThickness: 60
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1,
                                font: {
                                    size: 12
                                }
                            }
                        },
                        x: {
                            ticks: {
                                font: {
                                    size: 13,
                                    weight: 'bold'
                                }
                            }
                        }
                    }
                }
            });

        });
    </script>
}