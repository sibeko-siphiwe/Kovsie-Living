@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading mb-1">System Dashboard</h2>
            <p class="text-muted mb-0">Manage the estate with ease and clarity.</p>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Administrator"))
            {
                <a asp-action="Index" asp-controller="Report" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-file-alt me-1"></i>Reports
                </a>
                <a asp-action="Create" asp-controller="Customer" class="btn btn-sm btn-dark-soft">
                    <i class="fas fa-plus me-1"></i>New User
                </a>
            }
            @if (User.IsInRole("Officer"))
            {
                <a asp-action="Generate" asp-controller="Report" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-file-alt me-1"></i>Generate Report
                </a>
                <a asp-action="Create" asp-controller="Customer" class="btn btn-sm btn-dark-soft">
                    <i class="fas fa-plus me-1"></i>New User
                </a>
            }
        </div>
    </div>

    <div class="row g-2 mb-4">

        <div class="col-md">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="text-muted small text-uppercase">Customers</span>
                        <i class="fas fa-users text-muted"></i>
                    </div>
                    <h3 class="heading mb-1">@Model.Users.Count()</h3>
                    <p class="text-muted small mb-0">Registered users</p>
                </div>
            </div>
        </div>

        @if (User.IsInRole("Administrator"))
        {
            <div class="col-md">
                <div class="card stat-card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="text-muted small text-uppercase">Officers</span>
                            <i class="fas fa-user-shield text-muted"></i>
                        </div>
                        <h3 class="heading mb-1">@Model.Officers.Count()</h3>
                        <p class="text-muted small mb-0">Active officers</p>
                    </div>
                </div>
            </div>
        }

        @if (User.IsInRole("Officer"))
        {
            <div class="col-md">
                <div class="card stat-card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="text-muted small text-uppercase">Total Revenue</span>
                            <i class="fas fa-money-bill text-muted"></i>
                        </div>
                        <h3 class="heading mb-1">R @Model.TotalRevenue.ToString("N2")</h3>
                        <p class="text-muted small mb-0">Collected to date</p>
                    </div>
                </div>
            </div>
        }

        <div class="col-md">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="text-muted small text-uppercase">Pending Payments</span>
                        <i class="fas fa-clock text-muted"></i>
                    </div>
                    <h3 class="heading mb-1">@Model.PendingPaymentsCount</h3>
                    <p class="text-muted small mb-0">Awaiting processing</p>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-2 mb-4">

        <div class="col-lg-6">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <h6 class="heading mb-1">Payment Distribution</h6>
                    <p class="text-muted small mb-2">Revenue by tariff type</p>
                    <div style="position: relative; height: 260px;" class="border-top pt-3">
                        <canvas id="paymentDistributionChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <h6 class="heading mb-1">User Approval Status</h6>
                    <p class="text-muted small mb-2">Approved vs pending</p>
                    <div style="position: relative; height: 260px;" class="border-top pt-3">
                        <canvas id="userApprovalChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

    </div>

    @if (User.IsInRole("Administrator"))
    {
        <div class="card stat-card mb-4">
            <div class="card-body pb-0">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h6 class="heading mb-1">Registered Users</h6>
                    </div>
                    <a asp-action="Customers" asp-controller="Dashboard" class="btn btn-sm">
                        View All<i class="ms-2 fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            @if (Model.Users.Any())
            {
                <div class="table-responsive">
                    <table class="table table-clean mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.Users.Take(5))
                            {
                                <tr>
                                    <td class="fw-semibold">@u.FullName</td>
                                    <td class="text-muted">@u.Email</td>
                                    <td>
                                        <span class="@(u.IsActive ? "badge-soft-green" : "badge-soft-red")">
                                            @(u.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-nowrap text-end">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                                <i class="fas fa-ellipsis"></i>
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-sm dropdown-menu-end">
                                                <a asp-action="Details" asp-controller="Customer" asp-route-id="@u.Id" class="dropdown-item">
                                                    <i class="fas fa-eye me-2"></i>View
                                                </a>
                                                <a asp-action="Update" asp-controller="Customer" asp-route-id="@u.Id" class="dropdown-item">
                                                    <i class="fas fa-pen me-2"></i>Edit
                                                </a>
                                                <a asp-action="ChangePassword" asp-controller="Customer" asp-route-id="@u.Id" class="dropdown-item">
                                                    <i class="fas fa-key me-2"></i>Password
                                                </a>
                                                <div class="dropdown-divider"></div>
                                                <form asp-action="Delete" asp-controller="Customer" method="post" class="m-0" onsubmit="return confirm('Delete this user?')">
                                                    <input type="hidden" name="id" value="@u.Id" />
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="fas fa-trash me-2"></i>Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-user-alt fa-2x text-muted mb-3"></i>
                    <h6 class="heading mb-1">No Users Yet</h6>
                    <p class="text-muted small mb-0">Registered customers will appear here.</p>
                </div>
            }
        </div>
    }

    @if (User.IsInRole("Officer"))
    {
        <div class="card stat-card mb-4">
            <div class="card-body pb-0">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h6 class="heading mb-1">Recent Transactions</h6>
                        <p class="text-muted small mb-0">Latest customer payments</p>
                    </div>
                    <a asp-action="Pending" asp-controller="Payment" class="btn btn-sm btn-outline-secondary">
                        View All
                    </a>
                </div>
            </div>

            @if (Model.RecentPayments != null && Model.RecentPayments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-clean mb-0">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Service</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.RecentPayments)
                            {
                                string badgeClass = payment.Status switch
                                {
                                    "Paid" => "badge-soft-green",
                                    "Pending" => "badge-soft-yellow",
                                    "Rejected" => "badge-soft-red",
                                    _ => "badge-soft-gray"
                                };

                                <tr>
                                    <td class="fw-semibold">@payment.User?.FullName</td>
                                    <td>@payment.Tariff?.Name</td>
                                    <td class="fw-semibold">R @payment.Amount.ToString("N2")</td>
                                    <td class="text-muted">@payment.PaymentDate.ToString("dd MMM yyyy, HH:mm")</td>
                                    <td>
                                        <span class="@badgeClass">@payment.Status</span>
                                    </td>
                                    <td class="text-end">
                                        @if (payment.Status == "Pending")
                                        {
                                            <div class="d-flex gap-1 justify-content-end">
                                                <form asp-action="ApprovePayment" method="post" class="m-0">
                                                    <input type="hidden" name="id" value="@payment.PaymentId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Approve">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                </form>
                                                <form asp-action="RejectPayment" method="post" class="m-0" onsubmit="return confirm('Reject this payment?')">
                                                    <input type="hidden" name="id" value="@payment.PaymentId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Reject">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-receipt fa-2x text-muted mb-3"></i>
                    <h6 class="heading mb-1">No Transactions Yet</h6>
                    <p class="text-muted small mb-0">Recent payments will appear here.</p>
                </div>
            }
        </div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const softColors = ['#93c5fd', '#c4b5fd', '#86efac', '#fcd34d', '#fca5a5', '#a5b4fc', '#5eead4'];

            const ctx1 = document.getElementById('paymentDistributionChart');
            if (ctx1) {
                new Chart(ctx1, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Tariffs.Select(t => t.Name))),
                        datasets: [{
                            data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Tariffs.Select(t => t.Amount))),
                            backgroundColor: softColors,
                            borderWidth: 0,
                            hoverOffset: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '72%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    padding: 16,
                                    usePointStyle: true,
                                    pointStyle: 'circle',
                                    boxWidth: 8,
                                    font: { size: 12, family: 'system-ui' },
                                    color: '#495057'
                                }
                            }
                        }
                    }
                });
            }

            const ctx2 = document.getElementById('userApprovalChart');
            if (ctx2) {
                new Chart(ctx2, {
                    type: 'bar',
                    data: {
                        labels: ['Approved', 'Pending'],
                        datasets: [{
                            data: [@Model.ApprovedUsers, @Model.PendingUsers],
                            backgroundColor: ['#93c5fd', '#fcd34d'],
                            borderRadius: 8,
                            barThickness: 48
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { stepSize: 1, color: '#495057', font: { size: 11 } },
                                grid: { color: '#f1f3f5', drawBorder: false }
                            },
                            x: {
                                ticks: { color: '#212529', font: { size: 12, weight: '500' } },
                                grid: { display: false, drawBorder: false }
                            }
                        }
                    }
                });
            }

        });
    </script>
}