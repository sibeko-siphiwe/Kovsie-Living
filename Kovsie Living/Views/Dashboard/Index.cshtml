                </div>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function () {

            var ctx1 = document.getElementById('systemStatusChart').getContext('2d');

            var gradient1 = ctx1.createLinearGradient(0, 0, 200, 200);
            gradient1.addColorStop(0, '#198754');
            gradient1.addColorStop(1, '#20c997');

            var gradient2 = ctx1.createLinearGradient(0, 0, 200, 200);
            gradient2.addColorStop(0, '#dc3545');
            gradient2.addColorStop(1, '#f87171');

            new Chart(ctx1, {
                type: 'doughnut',
                data: {
                    labels: ['Active', 'Inactive'],
                    datasets: [{
                        data: [@Model.ActiveUsers, @Model.InactiveUsers],
                        backgroundColor: [gradient1, gradient2],
                        borderWidth: 3,
                        borderColor: '#ffffff',
                        hoverOffset: 15
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 20,
                                usePointStyle: true,
                                pointStyle: 'circle',
                                font: {
                                    size: 13,
                                    weight: 'bold'
                                }
                            }
                        }
                    }
                }
            });

            // ==========================================
            // CHART 2: Payment Status - Bar Chart with Rounded Corners
            // ==========================================
            var ctx2 = document.getElementById('paymentStatusChart').getContext('2d');

            new Chart(ctx2, {
                type: 'bar',
                data: {
                    labels: ['Approved', 'Pending'],
                    datasets: [{
                        label: 'Customers',
                        data: [@Model.ApprovedUsers, @Model.PendingUsers],
                        backgroundColor: [
                            'rgba(25, 135, 84, 0.8)',
                            'rgba(255, 193, 7, 0.8)'
                        ],
                        borderColor: ['#198754', '#ffc107'],
                        borderWidth: 2,
                        borderRadius: 8,
                        barThickness: 60
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1,
                                font: {
                                    size: 12
                                }
                            }
                        },
                        x: {
                            ticks: {
                                font: {
                                    size: 13,
                                    weight: 'bold'
                                }
                            }
                        }
                    }
                }
            });

        });
    </script>
}