@model IEnumerable<Tariff>
@{
    ViewData["Title"] = "Manage Tariffs";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading mb-1">Manage Tariffs</h2>
            <p class="text-muted mb-0">Set and update tariffs which customers interact with.</p>
        </div>
        <a asp-action="Create" asp-controller="Tariff" class="btn btn-sm btn-dark-soft">
            <i class="fas fa-plus me-1"></i>New Tariff
        </a>
    </div>

    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-4" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row g-2">
            @foreach (var tariff in Model)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 class="heading mb-1">@tariff.Name</h6>
                                    <p class="text-muted small mb-0">@tariff.Description</p>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-sm dropdown-menu-end">
                                        <a asp-action="Edit" asp-controller="Tariff" asp-route-id="@tariff.TariffId" class="dropdown-item">
                                            <i class="fas fa-pen me-2"></i>Edit
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <form asp-action="Delete" asp-controller="Tariff" method="post" class="m-0" onsubmit="return confirm('Delete this tariff?')">
                                            <input type="hidden" name="id" value="@tariff.TariffId" />
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fas fa-trash me-2"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <div class="border-top pt-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted small text-uppercase">Amount</span>
                                    <span class="fw-semibold">R @tariff.Amount.ToString("N2")</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small text-uppercase">Updated</span>
                                    <span class="text-muted small">@tariff.UpdatedAt.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card stat-card">
            <div class="card-body text-center py-5">
                <i class="fas fa-tags fa-2x text-muted mb-3"></i>
                <h6 class="heading mb-1">No Tariffs Yet</h6>
                <p class="text-muted small mb-3">Create your first tariff to get started.</p>
                <a asp-action="Create" asp-controller="Tariff" class="btn btn-sm btn-dark-soft">
                    <i class="fas fa-plus me-1"></i>Create First Tariff
                </a>
            </div>
        </div>
    }

</div>