@model IEnumerable<Tariff>
@{
    ViewData["Title"] = "Manage Tariffs";
    Layout = "_DashboardLayout";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between flex-wrap gap-2 align-items-end mb-4">
        <div>
            <h2 class="heading display-6">Manage Tariffs</h2>
            <p class="m-0 text-muted lead">Set and update tariffs which user can interact with</p>
        </div>
        <a asp-action="Create" asp-controller="Tariff" class="btn btn-dark">
            <i class="fas fa-add me-2"></i>Add New Tariff
        </a>
    </div>

    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-3" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var tariff in Model)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="card-title m-0">@tariff.Name</h5>
                                    <p class="text-muted small">@tariff.Description</p>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <a asp-action="Edit" asp-controller="Tariff" asp-route-id="@tariff.TariffId" class="dropdown-item">
                                            <i class="fas fa-edit me-2"></i>Edit
                                        </a>
                                        <form asp-action="Delete" asp-controller="Tariff" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to delete this tariff?')">
                                            <input type="hidden" name="id" value="@tariff.TariffId" />
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fas fa-trash me-2"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">Amount</span>
                                    <span class="fw-bold">R @tariff.Amount.ToString("F2")</span>
                                </div>
                                <div class="d-flex justify-content-between mt-1">
                                    <span class="text-muted small">Updated</span>
                                    <span class="small">@tariff.UpdatedAt.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="p-5 text-center border rounded">
            <i class="fas fa-tags fa-3x text-muted m-3"></i>
            <h5 class="text-muted">No Tariffs Yet</h5>
            <p class="mb-3 text-muted">Create new tariffs to get started!</p>
            <a asp-action="Create" asp-controller="Tariff" class="btn btn-dark">
                <i class="fas fa-add me-2"></i>Add New Tariff
            </a>
        </div>
    }

</div>