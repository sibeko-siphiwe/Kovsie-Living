@model IEnumerable<ContactMessage>
@{
    ViewData["Title"] = "Messages";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading mb-1">Contact Messages</h2>
            <p class="text-muted mb-0">
                Messages and issues reported by users.
                @if ((int)(ViewBag.UnreadCount ?? 0) > 0)
                {
                    <span class="badge-soft-yellow ms-2">@ViewBag.UnreadCount unread</span>
                }
            </p>
        </div>
    </div>

    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-4" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card stat-card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Messages" asp-controller="Dashboard">
                <div class="row g-2 align-items-end">
                    <div class="col-md-7">
                        <label class="form-label small text-muted text-uppercase">Search</label>
                        <input name="searchTerm" placeholder="Search by name, email, subject or content..."
                               class="form-control form-control-sm" value="@ViewBag.SearchTerm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted text-uppercase">Status</label>
                        <select name="statusFilter" class="form-select form-select-sm">
                            <option value="">All</option>
                            <option value="Unread" selected="@(ViewBag.StatusFilter == "Unread")">Unread</option>
                            <option value="Read" selected="@(ViewBag.StatusFilter == "Read")">Read</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-sm btn-dark-soft w-100">
                            <i class="fas fa-filter me-1"></i>Apply
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string) || !string.IsNullOrEmpty(ViewBag.StatusFilter as string))
                {
                    <div class="mt-3 pt-3 border-top">
                        <a asp-action="Messages" asp-controller="Dashboard" class="text-muted small text-decoration-none">
                            <i class="fas fa-times-circle me-1"></i>Clear all filters
                        </a>
                    </div>
                }
            </form>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body pb-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="heading mb-1">Inbox</h6>
                    <p class="text-muted small mb-0">
                        @ViewBag.TotalCount message@(ViewBag.TotalCount == 1 ? "" : "s") found
                    </p>
                </div>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <table class="table table-clean mb-0 w-100">
                <thead>
                    <tr>
                        <th style="width: 30px;"></th>
                        <th>From</th>
                        <th>Subject</th>
                        <th>Received</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in Model)
                    {
                        <tr class="@(msg.IsRead ? "" : "fw-semibold")">
                            <td>
                                @if (!msg.IsRead)
                                {
                                    <span class="badge-soft-blue" title="Unread">●</span>
                                }
                            </td>
                            <td>
                                <div>@msg.FullName</div>
                                <div class="text-muted small">@msg.Email</div>
                            </td>
                            <td>@msg.Subject</td>
                            <td class="text-muted">@msg.SubmittedAt.ToString("dd MMM yyyy, HH:mm")</td>
                            <td>
                                @if (msg.IsRead)
                                {
                                    <span class="badge-soft-green">Read</span>
                                }
                                else
                                {
                                    <span class="badge-soft-yellow">Unread</span>
                                }
                            </td>
                            <td class="text-nowrap text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown">
                                        <i class="fas fa-ellipsis"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-sm dropdown-menu-end">
                                        <a asp-action="MessageDetails" asp-route-id="@msg.ContactMessageId" class="dropdown-item">
                                            <i class="fas fa-eye me-2"></i>Open
                                        </a>
                                        <form asp-action="ToggleMessageRead" method="post" class="m-0">
                                            <input type="hidden" name="id" value="@msg.ContactMessageId" />
                                            <button type="submit" class="dropdown-item">
                                                <i class="fas @(msg.IsRead ? "fa-envelope" : "fa-envelope-open") me-2"></i>
                                                Mark as @(msg.IsRead ? "Unread" : "Read")
                                            </button>
                                        </form>
                                        <div class="dropdown-divider"></div>
                                        <form asp-action="DeleteMessage" method="post" class="m-0"
                                              onsubmit="return confirm('Delete this message?')">
                                            <input type="hidden" name="id" value="@msg.ContactMessageId" />
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fas fa-trash me-2"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            @if (ViewBag.TotalPages > 1)
            {
                <div class="card-body border-top">
                    <nav>
                        <ul class="pagination pagination-sm mb-0 justify-content-center">
                            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Messages"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-statusFilter="@ViewBag.StatusFilter"
                                   asp-route-page="@(ViewBag.CurrentPage - 1)">Previous</a>
                            </li>
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Messages"
                                       asp-route-searchTerm="@ViewBag.SearchTerm"
                                       asp-route-statusFilter="@ViewBag.StatusFilter"
                                       asp-route-page="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Messages"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-statusFilter="@ViewBag.StatusFilter"
                                   asp-route-page="@(ViewBag.CurrentPage + 1)">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-envelope-open fa-2x text-muted mb-3"></i>
                <h6 class="heading mb-1">No Messages Yet</h6>
                <p class="text-muted small mb-0">Messages submitted through the contact form will appear here.</p>
            </div>
        }
    </div>

</div>