@{
    ViewData["Title"] = "Home Page";
}
 
<div class="hero min-vh-100 d-flex justify-content-center align-items-center">
    <div class="container">
        <div class="container-wrapper text-light mx-auto p-5 rounded-5 text-center">
            <p class="m-0">Digital Estate Management</p>
            <h2 class="m-0 display-5 heading">A smarter way to live on campus</h2>
            <p class="m-0 lead">Kovsie Living connects accommodation, utilities, payments and estate services into one simple digital experience for students and staff</p>
        </div>
    </div>
</div>
 
<div class="py-5">
    <div class="container">
        <div class="row gap-4 align-items-center">
            <div class="col-md">
                <p class="m-0 lead text-muted" style="letter-spacing: 2px;">The challenge</p>
                <h2 class="m-0 display-5 heading">Estate management was never designed for today.</h2>
                <p class="m-0 lead">Traditional processes create unnecessary delays, manual records and difficult payment experiences.</p>
            </div>
            <div class="col-md">
                <div class="table-responsive">
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <td>
                                    <div class="d-flex gap-4 border-bottom pt-4 pb-3">
                                        <p class="m-0">01</p>
                                        <div>
                                            <h5>Manual Payments</h5>
                                            <p>Physical processes slow down residents.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex gap-4 border-bottom pt-4 pb-3">
                                        <p class="m-0">02</p>
                                        <div>
                                            <h5>Disconnected Information</h5>
                                            <p>Important records are difficult to access.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex gap-4 border-bottom pt-4 pb-3">
                                        <p class="m-0">03</p>
                                        <div>
                                            <h5>Limited Visibility</h5>
                                            <p>Users need transparency around their accounts.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
 
<div class="bg-dark">
    <div class="container py-5 text-center text-light">
        <p class="mt-5 mb-2 lead" style="letter-spacing: 2px;">The Solution</p>
        <h2 class="m-0 display-2 heading">A complete digital ecosystem for campus estates</h2>
        <p class="mt-3 mb-5 lead text-secondary">From registration to payments and service management, Kovsie Living creates a single connected experience.</p>
    </div>
</div>
 
<div class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="m-0 display-5 heading">Platform Services</h2>
            <p class="m-0 lead">Traditional processes create unnecessary delays, manual records and difficult payment experiences.</p>
        </div>
         
        <div class="row gap-4 mb-5 align-items-center">
            <div class="col-md">
                <div class="rounded overflow-hidden shadow">
                    <img src="~/images/Accommodation.jpg" alt="Accommodation" class="w-100 h-100 object-fit-cover" />
                </div>
            </div>
            <div class="col-md">
                <div>
                    <p class="text-muted lead mb-2">01 / Accommodation</p>
                    <h2 class="display-6 fw-bold mb-2">A complete view of your living space</h2>
                    <p class="text-secondary lead m-0">Residents can manage their accommodation information, account details and estate profile from one secure location.</p>
                    <ul class="navbar-nav gap-2 mt-3">
                        <li class="lead text-muted"><i class="fas fa-check me-2"></i>Residence information</li>
                        <li class="lead text-muted"><i class="fas fa-check me-2"></i>Personal account management</li>
                        <li class="lead text-muted"><i class="fas fa-check me-2"></i>Digital records</li>
                    </ul>
                </div>
            </div>
        </div>
         
        <div class="row gap-4 mb-5 align-items-center">
            <div class="col-md">
                <div>
                    <p class="text-muted lead mb-2">02 / Payments</p>
                    <h2 class="display-6 fw-bold mb-2">All payments. One place.</h2>
                    <p class="text-secondary lead mb-4">Pay for rent, electricity, water, parking and other estate services without unnecessary queues.</p>
                    <div class="border rounded p-4">
                        <div class="d-flex justify-content-between mb-3">
                            <p class="m-0 text-muted">Monthly Rent</p>
                            <p class="m-0 fw-bold">R3 500</p>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <p class="m-0 text-muted">Electricity</p>
                            <p class="m-0 fw-bold">R450</p>
                        </div>
                        <div class="d-flex justify-content-between">
                            <p class="m-0 text-muted">Water</p>
                            <p class="m-0 fw-bold">R250</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md">
                <div class="rounded overflow-hidden shadow">
                    <img src="~/images/Payment.jpg" alt="Payment" class="w-100 h-100 object-fit-cover" />
                </div>
            </div>
        </div>
         
        <div class="row gap-4 mb-5 align-items-center">
            <div class="col-md">
                <div class="rounded overflow-hidden shadow">
                    <img src="~/images/Information.jpg" alt="Information" class="w-100 h-100 object-fit-cover" />
                </div>
            </div>
            <div class="col-md">
                <div>
                    <p class="text-muted lead mb-2">03 / Communication</p>
                    <h2 class="display-6 fw-bold mb-2">Always stay informed.</h2>
                    <p class="text-secondary lead m-0">Receive important updates, payment confirmations and estate notifications instantly.</p>
                </div>
            </div>
        </div>
    </div>
</div>
 
<div class="py-5 bg-dark text-light">
    <div class="container">
        <div class="row gap-4 align-items-center">
            <div class="col-md">
                <p class="mb-4 lead" style="letter-spacing: 2px;">Security & Trust</p>
                <h2 class="mb-4 display-5 heading">Your information. Protected by design.</h2>
                <p class="m-0 lead">Kovsie Living keeps user information, payment records and estate activity organized through secure digital systems.</p>
            </div>
            <div class="col-md">
                <div class="table-responsive">
                    <table class="table table-borderless table-dark">
                        <tbody>
                            <tr>
                                <td>
                                    <div class="d-flex gap-4 border-bottom pt-4 pb-3">
                                        <p class="m-0"><i class="fas fa-user-shield fa-2x"></i></p>
                                        <div>
                                            <h5>Secure Accounts</h5>
                                            <p>Protected user authentication and profiles.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex gap-4 border-bottom pt-4 pb-3">
                                        <p class="m-0"><i class="fas fa-file-invoice-dollar fa-2x"></i></p>
                                        <div>
                                            <h5>Reliable Records</h5>
                                            <p>Payment history and estate information kept in one place.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="d-flex gap-4 border-bottom pt-4 pb-3">
                                        <p class="m-0"><i class="fas fa-users-cog fa-2x"></i></p>
                                        <div>
                                            <h5>Controlled Access</h5>
                                            <p>Different access levels for residents, officers and administrators.</p>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
 
<div class="py-5" id="faq">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="m-0 display-6 heading">Frequently asked questions</h2>
            <p class="mt-3 mb-5 lead text-secondary">
                From registration to payments and account management, Kovsie Living creates a single connected experience.
            </p>
        </div>

        <div class="justify-content-center">
            <div>

                <div class="accordion" id="faqAccordion">
                     
                    <div class="accordion-item border-0 mb-3 shadow-sm rounded-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingOne">
                            <button class="accordion-button fw-semibold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseOne"
                                    aria-expanded="true"
                                    aria-controls="collapseOne">
                                Who can use Kovsie Living?
                            </button>
                        </h2>
                        <div id="collapseOne"
                             class="accordion-collapse collapse show"
                             aria-labelledby="headingOne"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-secondary">
                                Kovsie Living is designed for University of the Free State Qwaqwa Campus students and staff members who use the university estate's accommodation and related services.
                            </div>
                        </div>
                    </div>
                     
                    <div class="accordion-item border-0 mb-3 shadow-sm rounded-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingTwo">
                            <button class="accordion-button collapsed fw-semibold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseTwo"
                                    aria-expanded="false"
                                    aria-controls="collapseTwo">
                                How do I create an account?
                            </button>
                        </h2>
                        <div id="collapseTwo"
                             class="accordion-collapse collapse"
                             aria-labelledby="headingTwo"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-secondary">
                                Students and staff members can register by providing their required personal information. Students provide details such as their name, surname and student number, while staff members provide their name, surname and personal or employee number.
                            </div>
                        </div>
                    </div>
                     
                    <div class="accordion-item border-0 mb-3 shadow-sm rounded-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingThree">
                            <button class="accordion-button collapsed fw-semibold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseThree"
                                    aria-expanded="false"
                                    aria-controls="collapseThree">
                                What payments can I make through Kovsie Living?
                            </button>
                        </h2>
                        <div id="collapseThree"
                             class="accordion-collapse collapse"
                             aria-labelledby="headingThree"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-secondary">
                                Kovsie Living allows users to manage payments for services such as rent, water usage, electricity, parking fees for additional vehicles, and refuse collection.
                            </div>
                        </div>
                    </div>
                     
                    <div class="accordion-item border-0 mb-3 shadow-sm rounded-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingFour">
                            <button class="accordion-button collapsed fw-semibold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseFour"
                                    aria-expanded="false"
                                    aria-controls="collapseFour">
                                What are the different user roles?
                            </button>
                        </h2>
                        <div id="collapseFour"
                             class="accordion-collapse collapse"
                             aria-labelledby="headingFour"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-secondary">
                                Kovsie Living has three user roles: <strong>Administrators</strong> manage the system and authorize financial officers, <strong>Financial Officers</strong> manage customer accounts and process payments, and <strong>Customers</strong> (students and staff) can register, make payments and view their account status.
                            </div>
                        </div>
                    </div>
                     
                    <div class="accordion-item border-0 mb-3 shadow-sm rounded-3 overflow-hidden">
                        <h2 class="accordion-header" id="headingFive">
                            <button class="accordion-button collapsed fw-semibold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseFive"
                                    aria-expanded="false"
                                    aria-controls="collapseFive">
                                Can I use Kovsie Living on my phone?
                            </button>
                        </h2>
                        <div id="collapseFive"
                             class="accordion-collapse collapse"
                             aria-labelledby="headingFive"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body text-secondary">
                                Yes! Kovsie Living includes both a web application and an Android mobile application. Both applications communicate with the same system, so you can access your account and make payments from any device, anywhere.
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>