@model CreateUserViewModel
@{
    ViewData["Title"] = "Create User";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading mb-1">Create New User</h2>
            <p class="text-muted mb-0">Register a new user to the system to get started.</p>
        </div>
        <a asp-action="Customers" asp-controller="Dashboard" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="card stat-card">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-12">
                        <label class="form-label small text-muted text-uppercase">User Type</label>
                        <div class="btn-group w-100" role="group" id="userTypeToggle">
                            <input type="radio" class="btn-check" asp-for="IsStudent" value="true" id="studentRadio" autocomplete="off" checked>
                            <label class="btn btn-sm btn-outline-secondary" for="studentRadio">Student</label>

                            <input type="radio" class="btn-check" asp-for="IsStudent" value="false" id="staffRadio" autocomplete="off">
                            <label class="btn btn-sm btn-outline-secondary" for="staffRadio">Staff</label>
                        </div>
                        <span asp-validation-for="IsStudent" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label small text-muted text-uppercase"></label>
                        <input asp-for="FirstName" class="form-control form-control-sm" placeholder="e.g John" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label small text-muted text-uppercase"></label>
                        <input asp-for="LastName" class="form-control form-control-sm" placeholder="e.g Doe" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="UserName" class="form-label small text-muted text-uppercase" id="userNameLabel">Student Number</label>
                        <input asp-for="UserName" class="form-control form-control-sm" placeholder="e.g 2010936382" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="UnitNumber" class="form-label small text-muted text-uppercase"></label>
                        <input asp-for="UnitNumber" class="form-control form-control-sm" placeholder="e.g A450" />
                        <span asp-validation-for="UnitNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="VehicleNumber" class="form-label small text-muted text-uppercase"></label>
                        <input asp-for="VehicleNumber" class="form-control form-control-sm" placeholder="e.g 3" />
                        <span asp-validation-for="VehicleNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="TemporaryPassword" class="form-label small text-muted text-uppercase"></label>
                        <input type="text" asp-for="TemporaryPassword" class="form-control form-control-sm" />
                        <span asp-validation-for="TemporaryPassword" class="text-danger small"></span>
                    </div>

                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-sm btn-dark-soft">
                        <i class="fas fa-check me-1"></i>Create User
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>