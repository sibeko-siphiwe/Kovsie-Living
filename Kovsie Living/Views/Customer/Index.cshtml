@model DashboardViewModel
@{
    ViewData["Title"] = "Customer Dashboard";
    Layout = "_DashboardLayout";
}

<div class="container-fluid">

    <div class="bg-dark text-light shadow rounded w-100 p-5 mt-3 mb-4">
        <div class="d-flex justify-content-between align-items-end">
            <div>
                <p class="m-0 lead">Welcome Back,</p>
                <h2 class="m-0 heading">@User.Identity.Name</h2>
            </div>
            <a class="btn btn-sm btn-outline-light"><i class="fas fa-hand-holding-dollar me-2"></i>Make Payment</a>
        </div>
    </div>

    <div class="row gap-2 g-2 mb-4">
        <div class="col-md">
            <div class="p-3 border rounded">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="mb-1">Amount Paid</h6>
                        <h2 class="mb-1">R0.00</h2>
                        <p class="text-muted small m-0">Total amount paid</p>
                    </div>
                    <div class="border border-success bg-success bg-opacity-10 p-2 rounded shadow-sm">
                        <i class="fas fa-money-bill text-success"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md">
            <div class="p-3 border rounded">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="mb-1">Pending Payments</h6>
                        <h2 class="mb-1">0</h2>
                        <p class="text-muted small m-0">Waiting for approval</p>
                    </div>
                    <div class="border border-warning bg-warning bg-opacity-10 p-2 rounded shadow-sm">
                        <i class="fas fa-clock-four text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md">
            <div class="p-3 border rounded">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h6 class="mb-1">Total Transactions</h6>
                        <h2 class="mb-1">0</h2>
                        <p class="text-muted small m-0">Transactions performed.</p>
                    </div>
                    <div class="border border-primary bg-primary bg-opacity-10 p-2 rounded shadow-sm">
                        <i class="fas fa-file-alt text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div>
        <div class="card">
            <div class="card-header text-center border-0 bg-white pb-0">
                <h6 class="m-0 p-0 pt-2">Recent Transactions</h6>
            </div>
            <div class="card-body">
                <div class="p-5 text-center border-top">
                    <i class="fas fa-address-card fa-3x text-muted m-3"></i>
                    <h5 class="text-muted">No Recent Transactions</h5>
                    <p class="mb-3 text-muted">All transactions will show here!</p>
                </div>

                @* @if (Model.Users.Any())
                    {
                        <div class="table-responsive-lg">
