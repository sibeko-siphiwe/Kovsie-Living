@model CustomerDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    <div class="card stat-card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <p class="text-muted small text-uppercase mb-1">Welcome Back</p>
                    <h2 class="heading mb-1">@Model.User.FirstName @Model.User.LastName</h2>
                    <p class="text-muted small mb-0">
                        @(Model.IsStudent ? "Student" : "Staff")
                        @if (!string.IsNullOrEmpty(Model.UnitNumber))
                        {
                            <span> · Unit @Model.UnitNumber</span>
                        }
                    </p>
                </div>
                <a asp-action="MakePayment" asp-controller="Payment" class="btn btn-sm btn-dark-soft">
                    <i class="fas fa-credit-card me-1"></i>Make Payment
                </a>
            </div>
        </div>
    </div>

    @if (TempData["message"] != null)
    {
        var messageType = TempData["messageType"]?.ToString() ?? "info";
        <div class="alert alert-@messageType alert-dismissible fade show mb-4" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-2 mb-4">
        <div class="col-md">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="text-muted small text-uppercase">Amount Paid</span>
                        <i class="fas fa-money-bill text-muted"></i>
                    </div>
                    <h3 class="heading mb-1">R @Model.TotalPaid.ToString("N2")</h3>
                    <p class="text-muted small mb-0">Total amount paid</p>
                </div>
            </div>
        </div>

        <div class="col-md">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="text-muted small text-uppercase">Pending Payments</span>
                        <i class="fas fa-clock text-muted"></i>
                    </div>
                    <h3 class="heading mb-1">R @Model.PendingPayments.ToString("N2")</h3>
                    <p class="text-muted small mb-0">Waiting for approval</p>
                </div>
            </div>
        </div>

        <div class="col-md">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="text-muted small text-uppercase">Transactions</span>
                        <i class="fas fa-receipt text-muted"></i>
                    </div>
                    <h3 class="heading mb-1">@Model.TransactionCount</h3>
                    <p class="text-muted small mb-0">Total transactions</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card stat-card">
        <div class="card-body pb-0">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="heading mb-1">Recent Transactions</h6>
                    <p class="text-muted small mb-0">Your latest payments</p>
                </div>
                <a asp-action="History" asp-controller="Payment" class="btn btn-sm btn-outline-secondary">
                    View All
                </a>
            </div>
        </div>

        @if (Model.RecentTransactions != null && Model.RecentTransactions.Any())
        {
            <table class="table table-clean mb-0 w-100">
                <thead>
                    <tr>
                        <th>Tariff</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Reference</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.RecentTransactions)
                    {
                        string badgeClass = payment.Status switch
                        {
                            "Paid" => "badge-soft-green",
                            "Pending" => "badge-soft-yellow",
                            "Rejected" => "badge-soft-red",
                            _ => "badge-soft-gray"
                        };

                        <tr>
                            <td class="fw-semibold">@payment.Tariff?.Name</td>
                            <td class="fw-semibold">R @payment.Amount.ToString("N2")</td>
                            <td class="text-muted">@payment.PaymentDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="@badgeClass">@payment.Status</span>
                            </td>
                            <td><code>@payment.Reference</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-receipt fa-2x text-muted mb-3"></i>
                <h6 class="heading mb-1">No Recent Transactions</h6>
                <p class="text-muted small mb-0">Your transactions will appear here.</p>
            </div>
        }
    </div>

</div>