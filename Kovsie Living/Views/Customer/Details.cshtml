@model ApplicationUser
@{
    ViewData["Title"] = "Customer Profile";
    Layout = "_DashboardLayout";

    var isStudent = Model.Student != null;
    var isStaff = Model.Staff != null;
    var userType = isStudent ? "Student" : (isStaff ? "Staff" : "Unknown");
    var unitNumber = isStudent ? Model.Student?.UnitNumber : (isStaff ? Model.Staff?.UnitNumber : "N/A");
    var vehicleCount = isStudent ? Model.Student?.VehicleNumber ?? 0 : (isStaff ? Model.Staff?.VehicleNumber ?? 0 : 0);
    var isApproved = isStudent ? (Model.Student?.IsApproved ?? false) : (isStaff ? (Model.Staff?.IsApproved ?? false) : true);

    string statusBadge;
    if (!Model.IsActive)
    {
        statusBadge = "badge-soft-red";
    }
    else if (!isApproved)
    {
        statusBadge = "badge-soft-yellow";
    }
    else
    {
        statusBadge = "badge-soft-green";
    }
}

<div class="container-fluid p-0">

    <div class="card stat-card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-3">

                        @if (Model.ProfilePicture != null && Model.ProfilePicture.Length > 0)
                        {
                            <img src="@Url.Action("ProfilePicture", "Account", new { id = Model.Id })"
                                 alt="Profile"
                                 class="user-avatar"
                                 style="width: 56px; height: 56px;" />
                        }
                        else
                        {
                            <div class="user-avatar" style="width: 56px; height: 56px; font-size: 1.1rem;">
                                @Model.FirstName[0]@Model.LastName[0]
                            </div>
                        }
                    </div>
                    <div>
                        <h4 class="heading mb-1">@Model.FullName</h4>
                        <div class="d-flex align-items-center gap-2 text-muted small">
                            <span>@Model.UserName</span>
                            <span>•</span>
                            <span>@userType</span>
                            <span>•</span>
                            <span class="@statusBadge">
                                @(Model.IsActive ? (isApproved ? "Active" : "Pending") : "Inactive")
                            </span>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Customers" asp-controller="Dashboard" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back
                    </a>
                    <a asp-action="Update" asp-controller="Customer" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-pen me-1"></i>Edit
                    </a>
                    <a asp-action="ChangePassword" asp-controller="Customer" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-key me-1"></i>Password
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="text-muted small text-uppercase">Username</span>
                        <i class="fas fa-id-badge text-muted"></i>
                    </div>
                    <h6 class="heading mb-0">@Model.UserName</h6>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="text-muted small text-uppercase">Unit Number</span>
                        <i class="fas fa-home text-muted"></i>
                    </div>
                    <h6 class="heading mb-0">@unitNumber</h6>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="text-muted small text-uppercase">Vehicles</span>
                        <i class="fas fa-car text-muted"></i>
                    </div>
                    <h6 class="heading mb-0">@vehicleCount</h6>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <span class="text-muted small text-uppercase">Joined</span>
                        <i class="fas fa-calendar text-muted"></i>
                    </div>
                    <h6 class="heading mb-0">@Model.CreatedAt.ToString("dd MMM yyyy")</h6>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-2 mb-4">

        <div class="col-lg-6">
            <div class="card stat-card h-100">
                <div class="card-body pb-0">
                    <h6 class="heading mb-3">Personal Information</h6>
                </div>
                <table class="table table-clean mb-0 w-100">
                    <tbody>
                        <tr>
                            <td class="text-muted">First Name</td>
                            <td class="fw-semibold text-end">@Model.FirstName</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Last Name</td>
                            <td class="fw-semibold text-end">@Model.LastName</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Email</td>
                            <td class="fw-semibold text-end">@Model.Email</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Phone</td>
                            <td class="fw-semibold text-end">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Last Login</td>
                            <td class="fw-semibold text-end">
                                @(Model.LastLoginAt.HasValue? Model.LastLoginAt.Value.ToString("dd MMM yyyy, HH:mm") : "Never")
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card stat-card h-100">
                <div class="card-body pb-0">
                    <h6 class="heading mb-3">Estate Information</h6>
                </div>
                <table class="table table-clean mb-0 w-100">
                    <tbody>
                        <tr>
                            <td class="text-muted">Unit Number</td>
                            <td class="fw-semibold text-end">@unitNumber</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Vehicles</td>
                            <td class="fw-semibold text-end">@vehicleCount</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Account Status</td>
                            <td class="text-end">
                                <span class="@(Model.IsActive ? "badge-soft-green" : "badge-soft-red")">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Approval</td>
                            <td class="text-end">
                                <span class="@(isApproved ? "badge-soft-green" : "badge-soft-yellow")">
                                    @(isApproved ? "Approved" : "Pending")
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Role</td>
                            <td class="fw-semibold text-end">@ViewBag.UserRole</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <div class="card stat-card mb-4">
        <div class="card-body pb-0">
            <h6 class="heading mb-3">Payment Summary</h6>
        </div>
        <table class="table table-clean mb-0 w-100">
            <tbody>
                <tr>
                    <td class="text-muted">Total Paid</td>
                    <td class="fw-semibold text-end">R @ViewBag.TotalPaid.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="text-muted">Total Pending</td>
                    <td class="fw-semibold text-end">R @ViewBag.TotalPending.ToString("N2")</td>
                </tr>
                <tr>
                    <td class="text-muted">Transactions</td>
                    <td class="fw-semibold text-end">@ViewBag.PaymentsCount</td>
                </tr>
            </tbody>
        </table>
    </div>

    @if (User.IsInRole("Administrator"))
    {
        <div class="card stat-card">
            <div class="card-body pb-0">
                <h6 class="heading mb-3">Admin Actions</h6>
            </div>
            <div class="card-body pt-0">
                <div class="d-flex flex-wrap gap-2">

                    @if (isStudent || isStaff)
                    {
                        <form asp-action="ToggleApproval" asp-controller="Customer" method="post" class="m-0">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                <i class="fas @(isApproved ? "fa-circle-xmark me-1" : "fa-circle-check me-1")"></i>
                                @(isApproved ? "Unapprove" : "Approve")
                            </button>
                        </form>
                    }

                    <form asp-action="ToggleActive" asp-controller="Customer" method="post" class="m-0">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            <i class="fas @(Model.IsActive ? "fa-circle-pause me-1" : "fa-circle-play me-1")"></i>
                            @(Model.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>

                    <form asp-action="Delete" asp-controller="Customer" method="post" class="m-0"
                          onsubmit="return confirm('Delete @Model.FullName? This cannot be undone.')">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="fas fa-trash me-1"></i>Delete
                        </button>
                    </form>

                </div>
            </div>
        </div>
    }

</div>