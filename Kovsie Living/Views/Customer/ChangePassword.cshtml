@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading mb-1">Change Password</h2>
            <p class="text-muted mb-0">Reset password for @Model.FullName</p>
        </div>
        <a asp-action="Customers" asp-controller="Dashboard" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="card stat-card">
        <div class="card-body">

            <form asp-action="ChangePassword" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row g-3">

                    <div class="col-md-12">
                        <label class="form-label small text-muted text-uppercase">User</label>
                        <input class="form-control form-control-sm" value="@Model.FullName" readonly />
                    </div>

                    <div class="col-md-12">
                        <label asp-for="NewPassword" class="form-label small text-muted text-uppercase"></label>
                        <input asp-for="NewPassword" class="form-control form-control-sm" placeholder="Enter new password" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="ConfirmPassword" class="form-label small text-muted text-uppercase"></label>
                        <input asp-for="ConfirmPassword" class="form-control form-control-sm" placeholder="Confirm new password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-sm btn-dark-soft">
                        <i class="fas fa-key me-1"></i>Change Password
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>