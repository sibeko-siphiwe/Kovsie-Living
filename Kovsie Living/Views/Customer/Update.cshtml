@model EditUserViewModel
@{
    ViewData["Title"] = "Update User";
    Layout = "_DashboardLayout";
}

<div class="container-fluid p-0">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <h2 class="heading mb-1">Update User</h2>
            <p class="text-muted mb-0">Edit user details and update to match relevant information.</p>
        </div>
        <a asp-action="Customers" asp-controller="Dashboard" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back
        </a>
    </div>

    <div class="card stat-card">
        <div class="card-body">

            <form asp-action="Update" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="IsStudent" />

                <div class="row g-3">

                    <div class="col-md-12">
                        <label class="form-label small text-muted text-uppercase">User Type</label>
                        <input class="form-control form-control-sm" value="@(Model.IsStudent ? "Student" : "Staff")" readonly />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label small text-muted text-uppercase"></label>
                        <input asp-for="FirstName" class="form-control form-control-sm" placeholder="e.g John" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label small text-muted text-uppercase"></label>
                        <input asp-for="LastName" class="form-control form-control-sm" placeholder="e.g Doe" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="UserName" class="form-label small text-muted text-uppercase">
                            @(Model.IsStudent ? "Student Number" : "Staff Number")
                        </label>
                        <input asp-for="UserName" class="form-control form-control-sm" placeholder="e.g 2010936382" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="UnitNumber" class="form-label small text-muted text-uppercase"></label>
                        <input asp-for="UnitNumber" class="form-control form-control-sm" placeholder="e.g A450" />
                        <span asp-validation-for="UnitNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="VehicleNumber" class="form-label small text-muted text-uppercase"></label>
                        <input asp-for="VehicleNumber" class="form-control form-control-sm" placeholder="e.g 3" />
                        <span asp-validation-for="VehicleNumber" class="text-danger small"></span>
                    </div>

                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-sm btn-dark-soft">
                        <i class="fas fa-check me-1"></i>Update User
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>