<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"] - Kovsie_Living</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Kovsie_Living.styles.css" asp-append-version="true" />
</head>
<body>

    <aside class="sidebar-desktop" id="desktopSidebar">
        <div class="sidebar-brand">
            <div class="d-flex align-items-center gap-2">
                <div class="brand-icon">
                    <i class="fas fa-building"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold">Kovsie Living</h6>
                    <p class="small m-0 text-muted">
                        @if (User.IsInRole("Administrator"))
                        {
                            @:Administrator
                        }
                        else if (User.IsInRole("Officer"))
                        {
                            @:Financial Officer
                        }
                        else
                        {
                            @:Customer
                        }
                    </p>
                </div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <ul class="nav flex-column gap-1">

                @if (User.IsInRole("Administrator"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Dashboard" class="sidebar-link">
                            <i class="fas fa-gauge me-3"></i>System Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Customers" asp-controller="Dashboard" class="sidebar-link">
                            <i class="fas fa-user-group me-3"></i>Manage Customers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Officers" asp-controller="Dashboard" class="sidebar-link">
                            <i class="fas fa-user-shield me-3"></i>Manage Officers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Tariffs" asp-controller="Dashboard" class="sidebar-link">
                            <i class="fas fa-tags me-3"></i>Manage Tariffs
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Pending" asp-controller="Payment" class="sidebar-link">
                            <i class="fas fa-clock me-3"></i>Pending Payments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Report" class="sidebar-link">
                            <i class="fas fa-file-alt me-3"></i>View Reports
                        </a>
                    </li>
                }

                @if (User.IsInRole("Officer"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Dashboard" class="sidebar-link">
                            <i class="fas fa-gauge me-3"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Customers" asp-controller="Dashboard" class="sidebar-link">
                            <i class="fas fa-user-group me-3"></i>Manage Customers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Pending" asp-controller="Payment" class="sidebar-link">
                            <i class="fas fa-clock me-3"></i>Pending Payments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="MyReports" asp-controller="Report" class="sidebar-link">
                            <i class="fas fa-history me-3"></i>My Reports
                        </a>
                    </li>
                }

                @if (User.IsInRole("Customer"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Customer" class="sidebar-link">
                            <i class="fas fa-gauge me-3"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="MakePayment" asp-controller="Payment" class="sidebar-link">
                            <i class="fas fa-credit-card me-3"></i>Make Payment
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="History" asp-controller="Payment" class="sidebar-link">
                            <i class="fas fa-history me-3"></i>Payment History
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Profile" asp-controller="Customer" class="sidebar-link">
                            <i class="fas fa-user me-3"></i>My Profile
                        </a>
                    </li>
                }

            </ul>
        </nav>
    </aside>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <aside class="sidebar-mobile" id="mobileSidebar">
        <div class="sidebar-mobile-header">
            <div class="d-flex align-items-center gap-2">
                <div class="brand-icon">
                    <i class="fas fa-building"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold">Kovsie Living</h6>
                    <p class="small m-0 text-muted">
                        @if (User.IsInRole("Administrator"))
                        {
                            @:Administrator
                        }
                        else if (User.IsInRole("Officer"))
                        {
                            @:Financial Officer
                        }
                        else
                        {
                            @:Customer
                        }
                    </p>
                </div>
            </div>
            <button class="btn btn-sm btn-outline-secondary" id="closeSidebarBtn">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <ul class="nav flex-column gap-1">

                @if (User.IsInRole("Administrator"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Dashboard" class="sidebar-link">
                            <i class="fas fa-gauge me-3"></i>System Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Customers" asp-controller="Dashboard" class="sidebar-link">
                            <i class="fas fa-user-group me-3"></i>Manage Customers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Officers" asp-controller="Dashboard" class="sidebar-link">
                            <i class="fas fa-user-shield me-3"></i>Manage Officers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Tariffs" asp-controller="Dashboard" class="sidebar-link">
                            <i class="fas fa-tags me-3"></i>Manage Tariffs
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Pending" asp-controller="Payment" class="sidebar-link">
                            <i class="fas fa-clock me-3"></i>Pending Payments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Report" class="sidebar-link">
                            <i class="fas fa-file-alt me-3"></i>View Reports
                        </a>
                    </li>
                }

                @if (User.IsInRole("Officer"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Dashboard" class="sidebar-link">
                            <i class="fas fa-gauge me-3"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Customers" asp-controller="Dashboard" class="sidebar-link">
                            <i class="fas fa-user-group me-3"></i>Manage Customers
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Pending" asp-controller="Payment" class="sidebar-link">
                            <i class="fas fa-clock me-3"></i>Pending Payments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="MyReports" asp-controller="Report" class="sidebar-link">
                            <i class="fas fa-history me-3"></i>My Reports
                        </a>
                    </li>
                }

                @if (User.IsInRole("Customer"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Customer" class="sidebar-link">
                            <i class="fas fa-gauge me-3"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="MakePayment" asp-controller="Payment" class="sidebar-link">
                            <i class="fas fa-credit-card me-3"></i>Make Payment
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="History" asp-controller="Payment" class="sidebar-link">
                            <i class="fas fa-history me-3"></i>Payment History
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-action="Profile" asp-controller="Customer" class="sidebar-link">
                            <i class="fas fa-user me-3"></i>My Profile
                        </a>
                    </li>
                }

            </ul>
        </nav>
    </aside>

    <div class="main-wrapper" id="mainWrapper">

        <header class="topbar">
            <div class="d-flex justify-content-between align-items-center w-100">

                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-icon d-lg-none" id="menuToggleBtn" aria-label="Toggle menu">
                        <i class="fas fa-bars"></i>
                    </button>
                    <a asp-action="Index" asp-controller="Home" class="d-none d-sm-block">
                        <img src="~/images/logo.png" width="150" alt="Kovsie Living Logo" />
                    </a>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div class="dropdown">
                        <button class="btn user-dropdown d-flex align-items-center gap-2 border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="text-start d-none d-sm-block">
                                <h6 class="mb-0 small fw-semibold">@User.Identity.Name</h6>
                                <p class="text-muted small m-0">
                                    @if (User.IsInRole("Administrator"))
                                    {
                                        @:Administrator
                                    }
                                    else if (User.IsInRole("Officer"))
                                    {
                                        @:Financial Officer
                                    }
                                    else
                                    {
                                        @:Customer
                                    }
                                </p>
                            </div>
                            <i class="fas fa-chevron-down small text-muted d-none d-sm-block"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li>
                                <form asp-action="Logout" asp-controller="Account" method="post" class="m-0">
                                    <button type="submit" class="dropdown-item">
                                        <i class="fas fa-door-open me-2"></i>Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
        </header>

        <main class="content-area">
            @RenderBody()
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>