<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"] - Kovsie_Living</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Kovsie_Living.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid p-0">
        <div class="row g-0"> 
            <div class="col-md-3 col-lg-3 border-end bg-white shadow-sm d-none d-md-block">
                <div class="p-3 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 bg-light shadow-sm bg-opacity-50 rounded">
                            <i class="fas fa-building text-dark"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold" style="letter-spacing: 1px">Kovsie Living</h6>
                            <p class="small m-0">Financial Officer</p>
                        </div>
                    </div>
                </div>

                <div class="p-3">
                    <ul class="nav flex-column gap-2">
                        <li class="nav-item">
                            <a asp-action="Index" asp-controller="Dashboard" class="nav-link text-dark nav-link-active px-3 py-2">
                                <i class="fas fa-gauge me-2"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-action="Customers" asp-controller="Dashboard" class="nav-link text-dark nav-link-hover px-3 py-2">
                                <i class="fas fa-user-group me-2"></i>Manage Customers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-action="Officers" asp-controller="Dashboard" class="nav-link text-dark nav-link-hover px-3 py-2">
                                <i class="fas fa-user-shield me-2"></i>Manage Officers
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
             
            <div class="sidebar-mobile bg-white shadow-sm" id="mobileSidebar">
                <div class="min-vh-100 d-flex flex-column">

                    <div class="p-3 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 bg-light shadow-sm bg-opacity-50 rounded">
                                <i class="fas fa-building text-dark"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold" style="letter-spacing: 1px">Kovsie Living</h6>
                                <p class="small m-0">Financial Officer</p>
                            </div> 
                        </div>
                    </div>

                    <div class="p-3">
                        <ul class="nav flex-column gap-2">
                            <li class="nav-item">
                                <a asp-action="Index" asp-controller="Dashboard" class="nav-link text-dark nav-link-active px-3 py-2">
                                    <i class="fas fa-gauge me-2"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Users" asp-controller="Dashboard" class="nav-link text-dark nav-link-hover px-3 py-2">
                                    <i class="fas fa-user-group me-2"></i>Manage Users
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Officers" asp-controller="Dashboard" class="nav-link text-dark nav-link-hover px-3 py-2">
                                    <i class="fas fa-user-shield me-2"></i>Manage Officers
                                </a>
                            </li>
                        </ul>
                    </div>
                    
                </div>
            </div>
             
            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
             
            <div class="col p-0">
                <div class="d-flex flex-column"> 
                    <div class="border-bottom bg-white shadow-sm p-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2"> 
                                <button class="btn btn-outline-secondary d-md-none" id="menuToggleBtn" aria-label="Toggle menu">
                                    <i class="fas fa-bars"></i>
                                </button>
                            </div>

                            <div>
                                <ul class="navbar-nav gap-2 align-items-center">
                                    <li class="nav-item dropdown">
                                        <button class="btn dropdown-toggle d-flex align-items-center gap-3 border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="p-2 bg-light border rounded">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                                <div class="text-start">
                                                    <h6 class="mb-0">@User.Identity.Name@@ufs4life.ac.za</h6>
                                                    <p class="text-muted small m-0">Administrator</p>
                                                </div>
                                            </div>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenu2">
                                            <form asp-action="Logout" asp-controller="Account" method="post" class="m-0">
                                                <button type="submit" class="dropdown-item">
                                                    <i class="fas fa-door-open me-2"></i>Sign Out
                                                </button>
                                            </form> 
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                     
                    <div class="main-scroll-area p-2 p-md-2 p-lg-2">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
