<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"] - Kovsie_Living</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Kovsie_Living.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="container-fluid p-0">
        <div class="d-flex">

            <!-- Desktop Sidebar -->
            <div class="d-none d-md-flex flex-column bg-white shadow-sm border-end" style="width: 250px; min-height: 100vh; position: sticky; top: 0;">
                <div class="p-3 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 bg-light shadow-sm bg-opacity-50 rounded">
                            <i class="fas fa-building text-dark"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold" style="letter-spacing: 1px">Kovsie Living</h6>
                            <p class="small m-0">
                                @if (User.IsInRole("Administrator"))
                                {
                                    @:Administrator
                                }
                                else if (User.IsInRole("Officer"))
                                {
                                    @:Financial Officer
                                }
                                else
                                {
                                    @:Customer
                                }
                            </p>
                        </div>
                    </div>
                </div>

                <div class="p-3 flex-grow-1">
                    <ul class="nav flex-column gap-2">

                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a asp-action="Index" asp-controller="Dashboard" class="nav-link text-dark nav-link-active px-3 py-2">
                                    <i class="fas fa-gauge me-2"></i>System Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Customers" asp-controller="Dashboard" class="nav-link text-dark nav-link-hover px-3 py-2">
                                    <i class="fas fa-user-group me-2"></i>Manage Customers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Officers" asp-controller="Dashboard" class="nav-link text-dark nav-link-hover px-3 py-2">
                                    <i class="fas fa-user-shield me-2"></i>Manage Officers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Tariffs" asp-controller="Dashboard" class="nav-link text-dark nav-link-hover px-3 py-2">
                                    <i class="fas fa-tags me-2"></i>Manage Tariffs
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Pending" asp-controller="Payment" class="nav-link text-dark nav-link-hover px-3 py-2">
                                    <i class="fas fa-clock me-2"></i>Pending Payments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Index" asp-controller="Report" class="nav-link text-dark nav-link-hover px-3 py-2">
                                    <i class="fas fa-file-alt me-2"></i>View Reports
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Officer"))
                        {
                            <li class="nav-item">
                                <a asp-action="Index" asp-controller="Dashboard" class="nav-link text-dark nav-link-active px-3 py-2">
                                    <i class="fas fa-gauge me-2"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Customers" asp-controller="Dashboard" class="nav-link text-dark nav-link-hover px-3 py-2">
                                    <i class="fas fa-user-group me-2"></i>Manage Customers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Pending" asp-controller="Payment" class="nav-link text-dark nav-link-hover px-3 py-2">
                                    <i class="fas fa-clock me-2"></i>Pending Payments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="MyReports" asp-controller="Report" class="nav-link text-dark nav-link-hover px-3 py-2">
                                    <i class="fas fa-history me-2"></i>My Reports
                                </a>
                            </li>
                        }

                        <!-- CLIENT NAVIGATION -->
                        @if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item">
                                <a asp-action="Index" asp-controller="Customer" class="nav-link text-dark nav-link-active px-3 py-2">
                                    <i class="fas fa-gauge me-2"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="MakePayment" asp-controller="Payment" class="nav-link text-dark nav-link-hover px-3 py-2">
                                    <i class="fas fa-credit-card me-2"></i>Make Payment
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="History" asp-controller="Payment" class="nav-link text-dark nav-link-hover px-3 py-2">
                                    <i class="fas fa-history me-2"></i>Payment History
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-action="Profile" asp-controller="Customer" class="nav-link text-dark nav-link-hover px-3 py-2">
                                    <i class="fas fa-user me-2"></i>My Profile
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>

            <!-- Mobile Sidebar (Offcanvas) -->
            <div class="sidebar-mobile bg-white shadow-sm" id="mobileSidebar">
                <div class="min-vh-100 d-flex flex-column">

                    <div class="p-3 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 bg-light shadow-sm bg-opacity-50 rounded">
                                <i class="fas fa-building text-dark"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold" style="letter-spacing: 1px">Kovsie Living</h6>
                                <p class="small m-0">
                                    @if (User.IsInRole("Administrator"))
                                    {
                                        @:Administrator
                                    }
                                    else if (User.IsInRole("Officer"))
                                    {
                                        @:Financial Officer
                                    }
                                    else
                                    {
                                        @:Customer
                                    }
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="p-3">
                        <ul class="nav flex-column gap-2">

                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a asp-action="Index" asp-controller="Dashboard" class="nav-link text-dark nav-link-active px-3 py-2">
                                        <i class="fas fa-gauge me-2"></i>System Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-action="Customers" asp-controller="Dashboard" class="nav-link text-dark nav-link-hover px-3 py-2">
                                        <i class="fas fa-user-group me-2"></i>Manage Customers
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-action="Officers" asp-controller="Dashboard" class="nav-link text-dark nav-link-hover px-3 py-2">
                                        <i class="fas fa-user-shield me-2"></i>Manage Officers
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-action="Tariffs" asp-controller="Dashboard" class="nav-link text-dark nav-link-hover px-3 py-2">
                                        <i class="fas fa-tags me-2"></i>Manage Tariffs
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Officer"))
                            {
                                <li class="nav-item">
                                    <a asp-action="Index" asp-controller="Dashboard" class="nav-link text-dark nav-link-active px-3 py-2">
                                        <i class="fas fa-gauge me-2"></i>Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-action="Customers" asp-controller="Dashboard" class="nav-link text-dark nav-link-hover px-3 py-2">
                                        <i class="fas fa-user-group me-2"></i>Manage Customers
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-action="Pending" asp-controller="Payment" class="nav-link text-dark nav-link-hover px-3 py-2">
                                        <i class="fas fa-clock me-2"></i>Pending Payments
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-action="MyReports" asp-controller="Report" class="nav-link text-dark nav-link-hover px-3 py-2">
                                        <i class="fas fa-history me-2"></i>My Reports
                                    </a>
                                </li>
                            }

                            <!-- CLIENT NAVIGATION -->
                            @if (User.IsInRole("Customer"))
                            {
                                <li class="nav-item">
                                    <a asp-action="Index" asp-controller="Customer" class="nav-link text-dark nav-link-active px-3 py-2">
                                        <i class="fas fa-gauge me-2"></i>Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-action="MakePayment" asp-controller="Payment" class="nav-link text-dark nav-link-hover px-3 py-2">
                                        <i class="fas fa-credit-card me-2"></i>Make Payment
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-action="History" asp-controller="Payment" class="nav-link text-dark nav-link-hover px-3 py-2">
                                        <i class="fas fa-clock-rotate me-2"></i>Payment History
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-action="Profile" asp-controller="Customer" class="nav-link text-dark nav-link-hover px-3 py-2">
                                        <i class="fas fa-user me-2"></i>My Profile
                                    </a>
                                </li>
                            }

                        </ul>
                    </div>

                </div>
            </div>

            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

            <!-- Main Content -->
            <div class="flex-grow-1" style="min-width: 0;">
                <div class="d-flex flex-column min-vh-100">

                    <!-- Top Bar -->
                    <div class="border-bottom bg-white p-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <button class="btn btn-outline-secondary d-md-none" id="menuToggleBtn" aria-label="Toggle menu">
                                    <i class="fas fa-bars"></i>
                                </button>
                            </div>
                            <a asp-action="Index" asp-controller="Home"><img src="~/images/logo.png" width="188" alt="Kovsie Living Logo" /></a>
                            <div>
                                <ul class="navbar-nav gap-2 align-items-center">
                                    <li class="nav-item dropdown">
                                        <button class="btn dropdown-toggle d-flex align-items-center gap-3 border-0" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="p-2 bg-light border rounded">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                                <div class="text-start d-none d-sm-block">
                                                    <h6 class="mb-0">@User.Identity.Name</h6>
                                                    <p class="text-muted small m-0">
                                                        @if (User.IsInRole("Administrator"))
                                                        {
                                                            @:Administrator
                                                        }
                                                        else if (User.IsInRole("Officer"))
                                                        {
                                                            @:Financial Officer
                                                        }
                                                        else
                                                        {
                                                            @:Customer
                                                        }
                                                    </p>
                                                </div>
                                            </div>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenu2">
                                            <form asp-action="Logout" asp-controller="Account" method="post" class="m-0">
                                                <button type="submit" class="dropdown-item">
                                                    <i class="fas fa-door-open me-2"></i>Sign Out
                                                </button>
                                            </form>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Scrollable Content Area -->
                    <div class="main-scroll-area p-2 p-md-3 p-lg-4 flex-grow-1">
                        @RenderBody()
                    </div>

                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>